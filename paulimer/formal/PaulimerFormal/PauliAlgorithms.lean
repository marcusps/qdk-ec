import BinarFormal.Echelon
import Mathlib.LinearAlgebra.Finsupp.LinearCombination
import PaulimerFormal.BinarBridge
import PaulimerFormal.PauliRepresentations

/-!
# Standalone Pauli algorithms

This module models the fixed-width mathematical core of
`paulimer/src/pauli/algorithms.rs`. Packed bit matrices reuse BinarFormal, while
the predicates and updates refine canonical phase-aware Pauli semantics. The
generated-group equality check is a complete finite reference decision
procedure, not a refinement of Rust's RREF-row comparison.
-/

namespace PaulimerFormal

open BinarFormal.Packed
open BinarFormal.Echelon

/-! ## Binary row encoding -/

/-- Concatenate packed X and Z coordinates in Paulimer's documented order. -/
def DensePauli.phaseBits {m : ℕ} (pauli : DensePauli m) :
    PackedVec (m + m) :=
  PackedVec.ofBoolFn (m + m) fun column =>
    if column < m then
      pauli.xBits.get column
    else
      pauli.zBits.get (column - m)

@[simp]
theorem DensePauli.decode_phaseBits_x {m : ℕ}
    (pauli : DensePauli m) (index : Fin m) :
    pauli.phaseBits.decode (Fin.castAdd m index) =
      pauli.decode.x index := by
  change
    Bool.toF2
        ((PackedVec.ofBoolFn (m + m) fun column =>
          if column < m then
            pauli.xBits.get column
          else
            pauli.zBits.get (column - m)).get index.val) =
      Bool.toF2 (pauli.xBits.get index.val)
  rw [PackedVec.get_ofBoolFn _ _ _ (by omega)]
  simp [index.isLt]

@[simp]
theorem DensePauli.decode_phaseBits_z {m : ℕ}
    (pauli : DensePauli m) (index : Fin m) :
    pauli.phaseBits.decode (Fin.natAdd m index) =
      pauli.decode.z index := by
  change
    Bool.toF2
        ((PackedVec.ofBoolFn (m + m) fun column =>
          if column < m then
            pauli.xBits.get column
          else
            pauli.zBits.get (column - m)).get (m + index.val)) =
      Bool.toF2 (pauli.zBits.get index.val)
  rw [PackedVec.get_ofBoolFn _ _ _ (by omega)]
  simp

/-- Canonical contiguous X-then-Z row represented by a phase-aware Pauli. -/
def Pauli.projectiveRow {m : ℕ} (pauli : Pauli m) :
    Fin (m + m) → F2 :=
  BinarBridge.toFinVector pauli.projective.toPhaseVector

@[simp]
theorem Pauli.projectiveRow_x {m : ℕ}
    (pauli : Pauli m) (index : Fin m) :
    pauli.projectiveRow (Fin.castAdd m index) = pauli.x index := by
  change
    pauli.projective.toPhaseVector
        ((BinarBridge.phaseIndexEquiv m).symm
          (Fin.castAdd m index)) =
      pauli.x index
  have inverse :
      (BinarBridge.phaseIndexEquiv m).symm
          (Fin.castAdd m index) =
        Sum.inl index := by
    apply (BinarBridge.phaseIndexEquiv m).injective
    simp
  rw [inverse]
  rfl

@[simp]
theorem Pauli.projectiveRow_z {m : ℕ}
    (pauli : Pauli m) (index : Fin m) :
    pauli.projectiveRow (Fin.natAdd m index) = pauli.z index := by
  change
    pauli.projective.toPhaseVector
        ((BinarBridge.phaseIndexEquiv m).symm
          (Fin.natAdd m index)) =
      pauli.z index
  have inverse :
      (BinarBridge.phaseIndexEquiv m).symm
          (Fin.natAdd m index) =
        Sum.inr index := by
    apply (BinarBridge.phaseIndexEquiv m).injective
    simp
  rw [inverse]
  rfl

@[simp]
theorem DensePauli.decode_phaseBits {m : ℕ}
    (pauli : DensePauli m) :
    pauli.phaseBits.decode = pauli.decode.projectiveRow := by
  funext column
  refine Fin.addCases ?_ ?_ column
  · intro index
    rw [pauli.decode_phaseBits_x,
      pauli.decode.projectiveRow_x]
  · intro index
    rw [pauli.decode_phaseBits_z,
      pauli.decode.projectiveRow_z]

/-- Packed analogue of Rust's `bitmatrix_from_paulis`. -/
def bitMatrixFromPaulis {m : ℕ}
    (paulis : List (DensePauli m)) :
    PackedMatrix paulis.length (m + m) where
  rows row := (paulis[row]).phaseBits

@[simp]
theorem decode_bitMatrixFromPaulis_row {m : ℕ}
    (paulis : List (DensePauli m))
    (row : Fin paulis.length) :
    (bitMatrixFromPaulis paulis).decode row =
      (paulis[row]).decode.projectiveRow := by
  exact DensePauli.decode_phaseBits _

/-- Binary row space generated by the projective coordinates of a Pauli list. -/
def projectiveSpan {m : ℕ}
    (paulis : List (DensePauli m)) :
    Submodule F2 (Fin (m + m) → F2) :=
  Submodule.span F2
    (Set.range fun row : Fin paulis.length =>
      (paulis[row]).decode.projectiveRow)

theorem bitMatrixFromPaulis_rowSpace {m : ℕ}
    (paulis : List (DensePauli m)) :
    Submodule.span F2
        (Set.range (bitMatrixFromPaulis paulis).decode) =
      projectiveSpan paulis := by
  congr 1
  ext vector
  constructor
  · rintro ⟨row, rfl⟩
    exact ⟨row, (decode_bitMatrixFromPaulis_row paulis row).symm⟩
  · rintro ⟨row, rfl⟩
    exact ⟨row, decode_bitMatrixFromPaulis_row paulis row⟩

/-! ## RREF basis completion -/

/-- A standard binary row with one set coordinate. -/
def standardRow {n : ℕ} (column : Fin n) : Fin n → F2 :=
  Pi.single column 1

/-- The pivot column at a given RREF pivot-row index. -/
def pivotColumn {rows columns : ℕ}
    (matrix : PackedMatrix rows columns)
    (index : Fin (EchelonForm.new matrix).pivots.length) :
    Fin columns :=
  ⟨(EchelonForm.new matrix).pivots.get index,
    (EchelonForm.new_isRREF matrix).lt_n _
      (List.get_mem _ index)⟩

/-- Distinct pivot-row indices select distinct pivot columns. -/
def pivotColumnEmbedding {rows columns : ℕ}
    (matrix : PackedMatrix rows columns) :
    Fin (EchelonForm.new matrix).pivots.length ↪ Fin columns where
  toFun := pivotColumn matrix
  inj' := by
    intro left right equal
    apply (EchelonForm.new_isRREF matrix).sorted.nodup.injective_get
    exact congrArg Fin.val equal

def pivotColumns {rows columns : ℕ}
    (matrix : PackedMatrix rows columns) :
    Finset (Fin columns) :=
  Finset.univ.map (pivotColumnEmbedding matrix)

def nonPivotColumns {rows columns : ℕ}
    (matrix : PackedMatrix rows columns) :
    Finset (Fin columns) :=
  Finset.univ \ pivotColumns matrix

@[simp]
theorem card_pivotColumns {rows columns : ℕ}
    (matrix : PackedMatrix rows columns) :
    (pivotColumns matrix).card =
      (EchelonForm.new matrix).pivots.length := by
  simp [pivotColumns]

theorem card_nonPivotColumns {rows columns : ℕ}
    (matrix : PackedMatrix rows columns) :
    (nonPivotColumns matrix).card =
      columns - (EchelonForm.new matrix).pivots.length := by
  simpa [nonPivotColumns] using
    (Finset.card_sdiff_of_subset
      (Finset.subset_univ (pivotColumns matrix)))

/-- The RREF row carrying a given pivot. -/
def pivotRow {rows columns : ℕ}
    (matrix : PackedMatrix rows columns)
    (index : Fin (EchelonForm.new matrix).pivots.length) :
    Fin columns → F2 :=
  (echelonize matrix).decode
    ⟨index.val,
      index.isLt.trans_le
        (EchelonForm.new_pivots_length_le matrix)⟩

@[simp]
theorem pivotRow_apply_pivotColumn {rows columns : ℕ}
    (matrix : PackedMatrix rows columns)
    (row pivot : Fin (EchelonForm.new matrix).pivots.length) :
    pivotRow matrix row (pivotColumn matrix pivot) =
      if row = pivot then 1 else 0 := by
  rw [pivotRow, PackedMatrix.decode_get]
  let packedRow : Fin rows :=
    ⟨row.val,
      row.isLt.trans_le
        (EchelonForm.new_pivots_length_le matrix)⟩
  have pivot_spec :=
    (echelonize_isRREF matrix).pivot_unit
      pivot.val pivot.isLt packedRow
  by_cases equal : row = pivot
  · subst pivot
    rw [ite_eq_left rfl]
    change
      Bool.toF2
          ((echelonize matrix).get packedRow
            ((EchelonForm.new matrix).pivots.get row)) =
        1
    have set :
        (echelonize matrix).get packedRow
          ((EchelonForm.new matrix).pivots.get row) =
          true :=
      pivot_spec.mpr rfl
    rw [set]
    rfl
  · rw [ite_eq_right equal]
    change
      Bool.toF2
          ((echelonize matrix).get packedRow
            ((EchelonForm.new matrix).pivots.get pivot)) =
        0
    have different : packedRow.val ≠ pivot.val := by
      intro values_equal
      exact equal (Fin.ext values_equal)
    have unset :
        (echelonize matrix).get packedRow
          ((EchelonForm.new matrix).pivots.get pivot) =
          false :=
      Bool.eq_false_iff.mpr fun set =>
        different (pivot_spec.mp set)
    rw [unset]
    rfl

theorem nonPivotColumn_ne_pivotColumn {rows columns : ℕ}
    (matrix : PackedMatrix rows columns)
    (column : {column // column ∈ nonPivotColumns matrix})
    (pivot : Fin (EchelonForm.new matrix).pivots.length) :
    column.1 ≠ pivotColumn matrix pivot := by
  intro equal
  have not_pivot :
      column.1 ∉ pivotColumns matrix :=
    (Finset.mem_sdiff.mp column.2).2
  have is_pivot :
      pivotColumn matrix pivot ∈ pivotColumns matrix :=
    Finset.mem_map.mpr
      ⟨pivot, Finset.mem_univ pivot, rfl⟩
  exact not_pivot (equal ▸ is_pivot)

/-- RREF pivot rows followed by standard rows for every non-pivot column. -/
abbrev RREFCompletionIndex {rows columns : ℕ}
    (matrix : PackedMatrix rows columns) :=
  Sum
    (Fin (EchelonForm.new matrix).pivots.length)
    {column // column ∈ nonPivotColumns matrix}

def rrefCompletionFamily {rows columns : ℕ}
    (matrix : PackedMatrix rows columns) :
    RREFCompletionIndex matrix → (Fin columns → F2)
  | Sum.inl row => pivotRow matrix row
  | Sum.inr column => standardRow column.1

theorem card_rrefCompletionIndex {rows columns : ℕ}
    (matrix : PackedMatrix rows columns) :
    Fintype.card (RREFCompletionIndex matrix) = columns := by
  have pivot_le :
      (EchelonForm.new matrix).pivots.length ≤ columns := by
    rw [← card_pivotColumns matrix]
    simpa using
      Finset.card_le_card
        (Finset.subset_univ (pivotColumns matrix))
  change
    Fintype.card
        (Sum
          (Fin (EchelonForm.new matrix).pivots.length)
          {column : Fin columns //
            column ∈ nonPivotColumns matrix}) =
      columns
  rw [Fintype.card_sum, Fintype.card_fin,
    Fintype.card_coe, card_nonPivotColumns]
  omega

theorem rrefCompletionFamily_linearIndependent
    {rows columns : ℕ}
    (matrix : PackedMatrix rows columns) :
    LinearIndependent F2 (rrefCompletionFamily matrix) := by
  rw [Fintype.linearIndependent_iff]
  intro coefficients combination_zero
  have pivot_coefficient_zero
      (pivot : Fin (EchelonForm.new matrix).pivots.length) :
      coefficients (Sum.inl pivot) = 0 := by
    have at_pivot :=
      congrFun combination_zero (pivotColumn matrix pivot)
    rw [Fintype.sum_sum_type] at at_pivot
    simpa [rrefCompletionFamily, Finset.sum_apply,
      Pi.smul_apply, standardRow,
      nonPivotColumn_ne_pivotColumn] using at_pivot
  intro index
  cases index with
  | inl pivot =>
      exact pivot_coefficient_zero pivot
  | inr column =>
      have at_column := congrFun combination_zero column.1
      rw [Fintype.sum_sum_type] at at_column
      simp [rrefCompletionFamily, Finset.sum_apply,
        Pi.smul_apply, standardRow,
        pivot_coefficient_zero] at at_column
      have single_apply
          (other :
            {column // column ∈ nonPivotColumns matrix}) :
          (Pi.single other.1 (1 : F2) :
              Fin columns → F2) column.1 =
            if other = column then 1 else 0 := by
        by_cases equal : other = column
        · subst equal
          simp
        · have values_ne : other.1 ≠ column.1 := by
            exact fun values_equal =>
              equal (Subtype.ext values_equal)
          simp [values_ne, equal]
      simp_rw [single_apply] at at_column
      simpa using at_column

theorem rrefCompletionFamily_span {rows columns : ℕ}
    (matrix : PackedMatrix rows columns) :
    Submodule.span F2
        (Set.range (rrefCompletionFamily matrix)) = ⊤ := by
  apply
    (rrefCompletionFamily_linearIndependent matrix).span_eq_top_of_card_eq_finrank'
  rw [card_rrefCompletionIndex]
  simp

/-- Row space completed by standard rows at every non-pivot column. -/
def rrefCompletedSpan {rows columns : ℕ}
    (matrix : PackedMatrix rows columns) :
    Submodule F2 (Fin columns → F2) :=
  Submodule.span F2 (Set.range matrix.decode) ⊔
    Submodule.span F2
      (Set.range fun
        column : {column // column ∈ nonPivotColumns matrix} =>
          standardRow column.1)

theorem rrefCompletedSpan_eq_top {rows columns : ℕ}
    (matrix : PackedMatrix rows columns) :
    rrefCompletedSpan matrix = ⊤ := by
  apply top_unique
  rw [← rrefCompletionFamily_span matrix]
  apply Submodule.span_le.mpr
  rintro _ ⟨index, rfl⟩
  cases index with
  | inl row =>
      apply
        (show
          Submodule.span F2 (Set.range matrix.decode) ≤
            rrefCompletedSpan matrix from le_sup_left)
      rw [← echelonize_rowSpace_eq matrix]
      apply Submodule.subset_span
      exact
        ⟨⟨row.val,
            row.isLt.trans_le
              (EchelonForm.new_pivots_length_le matrix)⟩,
          rfl⟩
  | inr column =>
      apply
        (show
          Submodule.span F2
              (Set.range fun
                column :
                  {column //
                    column ∈ nonPivotColumns matrix} =>
                  standardRow column.1) ≤
            rrefCompletedSpan matrix from le_sup_right)
      exact Submodule.subset_span (Set.mem_range_self column)

/-- Dense single-axis Pauli for a contiguous X-then-Z standard column. -/
def standardBasisPauli {m : ℕ}
    (column : Fin (m + m)) : DensePauli m :=
  if x_column : column.val < m then
    DensePauli.singleX ⟨column.val, x_column⟩
  else
    DensePauli.singleZ
      ⟨column.val - m, by omega⟩

@[simp]
theorem standardBasisPauli_castAdd {m : ℕ}
    (index : Fin m) :
    standardBasisPauli (Fin.castAdd m index) =
      DensePauli.singleX index := by
  simp [standardBasisPauli]

@[simp]
theorem standardBasisPauli_natAdd {m : ℕ}
    (index : Fin m) :
    standardBasisPauli (Fin.natAdd m index) =
      DensePauli.singleZ index := by
  simp [standardBasisPauli]

@[simp]
theorem decode_standardBasisPauli_projectiveRow {m : ℕ}
    (column : Fin (m + m)) :
    (standardBasisPauli column).decode.projectiveRow =
      standardRow column := by
  refine Fin.addCases ?_ ?_ column
  · intro x_column
    funext coordinate
    refine Fin.addCases ?_ ?_ coordinate
    · intro x_index
      rw [standardBasisPauli_castAdd,
        DensePauli.decode_singleX, Pauli.projectiveRow_x]
      simp only [ProjectivePauli.singleX,
        Pauli.ofProjective]
      change
        (Pi.single x_column (1 : F2) :
            Fin m → F2) x_index =
          (Pi.single (Fin.castAdd m x_column) (1 : F2) :
            Fin (m + m) → F2) (Fin.castAdd m x_index)
      by_cases equal : x_column = x_index
      · subst equal
        simp
      · have cast_ne :
            Fin.castAdd m x_column ≠
              Fin.castAdd m x_index := by
          intro cast_equal
          apply equal
          apply Fin.ext
          have values_equal :=
            congrArg
              (fun index : Fin (m + m) => index.val)
              cast_equal
          simpa using values_equal
        rw [Pi.single_eq_of_ne (fun h => equal h.symm),
          Pi.single_eq_of_ne (fun h => cast_ne h.symm)]
    · intro z_index
      rw [standardBasisPauli_castAdd,
        DensePauli.decode_singleX, Pauli.projectiveRow_z]
      simp only [ProjectivePauli.singleX,
        Pauli.ofProjective]
      change
        (0 : F2) =
          (Pi.single (Fin.castAdd m x_column) (1 : F2) :
            Fin (m + m) → F2) (Fin.natAdd m z_index)
      have disjoint :
          Fin.castAdd m x_column ≠
            Fin.natAdd m z_index := by
        intro equal
        have values_equal := congrArg Fin.val equal
        simp at values_equal
        omega
      rw [Pi.single_eq_of_ne (fun h => disjoint h.symm)]
  · intro z_column
    funext coordinate
    refine Fin.addCases ?_ ?_ coordinate
    · intro x_index
      rw [standardBasisPauli_natAdd,
        DensePauli.decode_singleZ, Pauli.projectiveRow_x]
      simp only [ProjectivePauli.singleZ,
        Pauli.ofProjective]
      change
        (0 : F2) =
          (Pi.single (Fin.natAdd m z_column) (1 : F2) :
            Fin (m + m) → F2) (Fin.castAdd m x_index)
      have disjoint :
          Fin.natAdd m z_column ≠
            Fin.castAdd m x_index := by
        intro equal
        have values_equal := congrArg Fin.val equal
        simp at values_equal
        omega
      rw [Pi.single_eq_of_ne (fun h => disjoint h.symm)]
    · intro z_index
      rw [standardBasisPauli_natAdd,
        DensePauli.decode_singleZ, Pauli.projectiveRow_z]
      simp only [ProjectivePauli.singleZ,
        Pauli.ofProjective]
      change
        (Pi.single z_column (1 : F2) :
            Fin m → F2) z_index =
          (Pi.single (Fin.natAdd m z_column) (1 : F2) :
            Fin (m + m) → F2) (Fin.natAdd m z_index)
      by_cases equal : z_column = z_index
      · subst equal
        simp
      · have natAdd_ne :
            Fin.natAdd m z_column ≠
              Fin.natAdd m z_index := by
          intro natAdd_equal
          apply equal
          apply Fin.ext
          have values_equal :=
            congrArg
              (fun index : Fin (m + m) => index.val)
              natAdd_equal
          simp at values_equal
          omega
        rw [Pi.single_eq_of_ne (fun h => equal h.symm),
          Pi.single_eq_of_ne (fun h => natAdd_ne h.symm)]

/-- Sorted complement of the RREF rank profile. -/
def completionColumns {m : ℕ}
    (paulis : List (DensePauli m)) :
    List (Fin (m + m)) :=
  (nonPivotColumns (bitMatrixFromPaulis paulis)).sort (· ≤ ·)

/-- Rust-shaped successful result of `complete_to_full_pauli_basis`. -/
def completeToFullPauliBasis {m : ℕ}
    (paulis : List (DensePauli m)) :
    List (DensePauli m) :=
  paulis ++
    (completionColumns paulis).map standardBasisPauli

@[simp]
theorem completeToFullPauliBasis_take {m : ℕ}
    (paulis : List (DensePauli m)) :
    (completeToFullPauliBasis paulis).take paulis.length =
      paulis := by
  simp [completeToFullPauliBasis]

def ProjectivelyIndependent {m : ℕ}
    (paulis : List (DensePauli m)) : Prop :=
  LinearIndependent F2 fun index : Fin paulis.length =>
    (paulis[index]).decode.projectiveRow

theorem projectiveRow_mem_projectiveSpan {m : ℕ}
    {paulis : List (DensePauli m)}
    {pauli : DensePauli m}
    (member : pauli ∈ paulis) :
    pauli.decode.projectiveRow ∈ projectiveSpan paulis := by
  apply Submodule.subset_span
  have indexed : pauli ∈ Set.range paulis.get := by
    rw [Set.range_list_get]
    exact member
  rcases indexed with ⟨index, rfl⟩
  exact Set.mem_range_self index

theorem projectivelyIndependent_matrix_rank {m : ℕ}
    {paulis : List (DensePauli m)}
    (independent : ProjectivelyIndependent paulis) :
    (bitMatrixFromPaulis paulis).decode.rank =
      paulis.length := by
  have matrix_independent :
      LinearIndependent F2
        (bitMatrixFromPaulis paulis).decode.row := by
    change
      LinearIndependent F2
        (bitMatrixFromPaulis paulis).decode
    have rows_equal :
        (bitMatrixFromPaulis paulis).decode =
          fun index : Fin paulis.length =>
            (paulis[index]).decode.projectiveRow := by
      funext index
      exact decode_bitMatrixFromPaulis_row paulis index
    rw [rows_equal]
    exact independent
  simpa using matrix_independent.rank_matrix

theorem projectivelyIndependent_pivots_length {m : ℕ}
    {paulis : List (DensePauli m)}
    (independent : ProjectivelyIndependent paulis) :
    (EchelonForm.new
      (bitMatrixFromPaulis paulis)).pivots.length =
        paulis.length := by
  rw [EchelonForm.new_pivots_length_eq_rank]
  exact projectivelyIndependent_matrix_rank independent

theorem projectivelyIndependent_length_le {m : ℕ}
    {paulis : List (DensePauli m)}
    (independent : ProjectivelyIndependent paulis) :
    paulis.length ≤ m + m := by
  have card_le := independent.fintype_card_le_finrank
  simpa using card_le

theorem completeToFullPauliBasis_length {m : ℕ}
    {paulis : List (DensePauli m)}
    (independent : ProjectivelyIndependent paulis) :
    (completeToFullPauliBasis paulis).length = m + m := by
  have pivots_length :=
    projectivelyIndependent_pivots_length independent
  have length_le :=
    projectivelyIndependent_length_le independent
  rw [completeToFullPauliBasis, List.length_append,
    List.length_map]
  have columns_length :
      (completionColumns paulis).length =
        (nonPivotColumns
          (bitMatrixFromPaulis paulis)).card := by
    simp [completionColumns]
  rw [columns_length, card_nonPivotColumns, pivots_length]
  omega

@[simp]
theorem mem_completionColumns_iff {m : ℕ}
    (paulis : List (DensePauli m))
    (column : Fin (m + m)) :
    column ∈ completionColumns paulis ↔
      column ∈ nonPivotColumns
        (bitMatrixFromPaulis paulis) := by
  simp [completionColumns]

theorem completeToFullPauliBasis_span {m : ℕ}
    (paulis : List (DensePauli m)) :
    projectiveSpan (completeToFullPauliBasis paulis) = ⊤ := by
  apply top_unique
  rw [← rrefCompletedSpan_eq_top
    (bitMatrixFromPaulis paulis)]
  apply sup_le
  · rw [bitMatrixFromPaulis_rowSpace]
    apply Submodule.span_le.mpr
    rintro _ ⟨row, rfl⟩
    apply projectiveRow_mem_projectiveSpan
    exact
      List.mem_append.mpr
        (Or.inl (List.get_mem paulis row))
  · apply Submodule.span_le.mpr
    rintro _ ⟨column, rfl⟩
    change
      standardRow column.1 ∈
        projectiveSpan
          (completeToFullPauliBasis paulis)
    rw [← decode_standardBasisPauli_projectiveRow]
    apply projectiveRow_mem_projectiveSpan
    apply List.mem_append.mpr
    right
    apply List.mem_map.mpr
    exact
      ⟨column.1,
        (mem_completionColumns_iff paulis column.1).mpr
          column.2,
        rfl⟩

theorem completeToFullPauliBasis_linearIndependent {m : ℕ}
    {paulis : List (DensePauli m)}
    (independent : ProjectivelyIndependent paulis) :
    ProjectivelyIndependent
      (completeToFullPauliBasis paulis) := by
  unfold ProjectivelyIndependent
  apply
    linearIndependent_of_top_le_span_of_card_eq_finrank
  · change
      ⊤ ≤
        projectiveSpan
          (completeToFullPauliBasis paulis)
    rw [completeToFullPauliBasis_span]
  · rw [completeToFullPauliBasis_length independent]
    simp

theorem projectivelyIndependent_iff_packedRank_eq {m : ℕ}
    (paulis : List (DensePauli m)) :
    ProjectivelyIndependent paulis ↔
      PackedMatrix.rank (bitMatrixFromPaulis paulis) =
        paulis.length := by
  constructor
  · intro independent
    exact projectivelyIndependent_pivots_length independent
  · intro rank_equal
    have decoded_rank :
        (bitMatrixFromPaulis paulis).decode.rank =
          paulis.length := by
      rw [← PackedMatrix.rank_eq_decode_rank]
      exact rank_equal
    have matrix_independent :
        LinearIndependent F2
          (bitMatrixFromPaulis paulis).decode.row := by
      rw [linearIndependent_iff_card_eq_finrank_span, Set.finrank]
      rw [← Matrix.rank_eq_finrank_span_row]
      simpa using decoded_rank.symm
    unfold ProjectivelyIndependent
    have rows_equal :
        (bitMatrixFromPaulis paulis).decode =
          fun index : Fin paulis.length =>
            (paulis[index]).decode.projectiveRow := by
      funext index
      exact decode_bitMatrixFromPaulis_row paulis index
    rw [← rows_equal]
    change
      LinearIndependent F2
        (bitMatrixFromPaulis paulis).decode.row
    exact matrix_independent

/-- Executable fixed-width form of Rust's independence assertion. -/
def completeToFullPauliBasisSucceeds {m : ℕ}
    (paulis : List (DensePauli m)) : Bool :=
  decide
    (PackedMatrix.rank (bitMatrixFromPaulis paulis) =
      paulis.length)

theorem completeToFullPauliBasisSucceeds_eq_true_iff {m : ℕ}
    (paulis : List (DensePauli m)) :
    completeToFullPauliBasisSucceeds paulis = true ↔
      ProjectivelyIndependent paulis := by
  rw [completeToFullPauliBasisSucceeds, decide_eq_true_eq]
  exact (projectivelyIndependent_iff_packedRank_eq paulis).symm

/-- Total wrapper for the independence assertion in the fixed-width model. -/
def completeToFullPauliBasis? {m : ℕ}
    (paulis : List (DensePauli m)) :
    Option (List (DensePauli m)) :=
  if completeToFullPauliBasisSucceeds paulis then
    some (completeToFullPauliBasis paulis)
  else
    none

theorem completeToFullPauliBasis?_eq_some_iff {m : ℕ}
    (paulis : List (DensePauli m)) :
    completeToFullPauliBasis? paulis =
        some (completeToFullPauliBasis paulis) ↔
      ProjectivelyIndependent paulis := by
  by_cases succeeds :
      completeToFullPauliBasisSucceeds paulis = true
  · have independent :=
      (completeToFullPauliBasisSucceeds_eq_true_iff
        paulis).mp succeeds
    simp [completeToFullPauliBasis?, succeeds, independent]
  · have fails :
      completeToFullPauliBasisSucceeds paulis = false :=
      Bool.eq_false_of_not_eq_true succeeds
    have not_independent :
        ¬ProjectivelyIndependent paulis := by
      exact fun independent =>
        succeeds
          ((completeToFullPauliBasisSucceeds_eq_true_iff
            paulis).mpr independent)
    simp [completeToFullPauliBasis?, fails, not_independent]

theorem completeToFullPauliBasis?_eq_none_iff {m : ℕ}
    (paulis : List (DensePauli m)) :
    completeToFullPauliBasis? paulis = none ↔
      ¬ProjectivelyIndependent paulis := by
  by_cases succeeds :
      completeToFullPauliBasisSucceeds paulis = true
  · have independent :=
      (completeToFullPauliBasisSucceeds_eq_true_iff
        paulis).mp succeeds
    simp [completeToFullPauliBasis?, succeeds, independent]
  · have fails :
      completeToFullPauliBasisSucceeds paulis = false :=
      Bool.eq_false_of_not_eq_true succeeds
    have not_independent :
        ¬ProjectivelyIndependent paulis := by
      exact fun independent =>
        succeeds
          ((completeToFullPauliBasisSucceeds_eq_true_iff
            paulis).mpr independent)
    simp [completeToFullPauliBasis?, fails, not_independent]

/-! ## Projective generated-group equality -/

/-- Every binary linear combination of the encoded Pauli rows. -/
def generatedProjectiveRows {m : ℕ}
    (paulis : List (DensePauli m)) :
    Finset (Fin (m + m) → F2) :=
  Finset.univ.image fun coefficients : Fin paulis.length → F2 =>
    ∑ row, coefficients row • (paulis[row]).decode.projectiveRow

theorem mem_generatedProjectiveRows_iff {m : ℕ}
    (paulis : List (DensePauli m))
    (vector : Fin (m + m) → F2) :
    vector ∈ generatedProjectiveRows paulis ↔
      vector ∈ projectiveSpan paulis := by
  rw [projectiveSpan, Submodule.mem_span_range_iff_exists_fun]
  simp [generatedProjectiveRows, eq_comm]

/-- Complete reference decision procedure for projective generated-group equality. -/
def areTheSameGroupUpToPhases {m : ℕ}
    (left right : List (DensePauli m)) : Bool :=
  decide (generatedProjectiveRows left = generatedProjectiveRows right)

theorem areTheSameGroupUpToPhases_eq_true_iff {m : ℕ}
    (left right : List (DensePauli m)) :
    areTheSameGroupUpToPhases left right = true ↔
      projectiveSpan left = projectiveSpan right := by
  rw [areTheSameGroupUpToPhases, decide_eq_true_eq]
  constructor
  · intro equal
    ext vector
    rw [← mem_generatedProjectiveRows_iff,
      equal, mem_generatedProjectiveRows_iff]
  · intro equal
    ext vector
    rw [mem_generatedProjectiveRows_iff,
      equal, ← mem_generatedProjectiveRows_iff]

/-! ## Commutation queries -/

/-- Packed symplectic pairing as a Boolean parity. -/
def DensePauli.commutationParity {m : ℕ}
    (left right : DensePauli m) : Bool :=
  (left.xBits.dot right.zBits) ^^
    (left.zBits.dot right.xBits)

theorem DensePauli.toF2_commutationParity {m : ℕ}
    (left right : DensePauli m) :
    Bool.toF2 (commutationParity left right) =
      ProjectivePauli.commutationPairing
        left.decode.projective right.decode.projective := by
  rw [DensePauli.commutationParity, Bool.toF2_xor,
    PackedVec.dot_eq_dotProduct, PackedVec.dot_eq_dotProduct]
  change
    left.xBits.decode ⬝ᵥ right.zBits.decode +
        left.zBits.decode ⬝ᵥ right.xBits.decode =
      left.zBits.decode ⬝ᵥ right.xBits.decode +
        right.zBits.decode ⬝ᵥ left.xBits.decode
  rw [dotProduct_comm right.zBits.decode left.xBits.decode]
  abel

def DensePauli.antiCommutes {m : ℕ}
    (left right : DensePauli m) : Bool :=
  commutationParity left right

def DensePauli.commutes {m : ℕ}
    (left right : DensePauli m) : Bool :=
  !(commutationParity left right)

theorem DensePauli.antiCommutes_eq_true_iff {m : ℕ}
    (left right : DensePauli m) :
    antiCommutes left right = true ↔
      ProjectivePauli.commutationPairing
        left.decode.projective right.decode.projective = 1 := by
  unfold antiCommutes
  rw [← DensePauli.toF2_commutationParity]
  generalize DensePauli.commutationParity left right = parity
  cases parity <;> decide

theorem DensePauli.antiCommutes_eq_false_iff {m : ℕ}
    (left right : DensePauli m) :
    antiCommutes left right = false ↔
      ProjectivePauli.commutationPairing
        left.decode.projective right.decode.projective = 0 := by
  unfold antiCommutes
  rw [← DensePauli.toF2_commutationParity]
  generalize DensePauli.commutationParity left right = parity
  cases parity <;> decide

theorem DensePauli.commutes_eq_true_iff {m : ℕ}
    (left right : DensePauli m) :
    commutes left right = true ↔
      ProjectivePauli.commutationPairing
        left.decode.projective right.decode.projective = 0 := by
  unfold commutes
  rw [← DensePauli.toF2_commutationParity]
  generalize DensePauli.commutationParity left right = parity
  cases parity <;> decide

/-- Indices of operators that anticommute with `observable`. -/
def indexedAntiCommutatorsOf {m : ℕ}
    (observable : DensePauli m)
    (paulis : List (DensePauli m)) :
    Finset (Fin paulis.length) :=
  Finset.univ.filter fun index =>
    observable.antiCommutes paulis[index]

/-- Indices of operators that commute with `observable`. -/
def indexedCommutatorsOf {m : ℕ}
    (observable : DensePauli m)
    (paulis : List (DensePauli m)) :
    Finset (Fin paulis.length) :=
  Finset.univ.filter fun index =>
    observable.commutes paulis[index]

@[simp]
theorem mem_indexedAntiCommutatorsOf_iff {m : ℕ}
    (observable : DensePauli m)
    (paulis : List (DensePauli m))
    (index : Fin paulis.length) :
    index ∈ indexedAntiCommutatorsOf observable paulis ↔
      ProjectivePauli.commutationPairing
        observable.decode.projective
        (paulis[index]).decode.projective = 1 := by
  simp [indexedAntiCommutatorsOf,
    DensePauli.antiCommutes_eq_true_iff]

@[simp]
theorem mem_indexedCommutatorsOf_iff {m : ℕ}
    (observable : DensePauli m)
    (paulis : List (DensePauli m))
    (index : Fin paulis.length) :
    index ∈ indexedCommutatorsOf observable paulis ↔
      ProjectivePauli.commutationPairing
        observable.decode.projective
        (paulis[index]).decode.projective = 0 := by
  simp [indexedCommutatorsOf,
    DensePauli.commutes_eq_true_iff]

/-- Pairwise commutation check over the same unordered pairs as Rust's triangular loop. -/
def areMutuallyCommuting {m : ℕ} :
    List (DensePauli m) → Bool
  | [] => true
  | pauli :: paulis =>
      paulis.all (pauli.commutes ·) &&
        areMutuallyCommuting paulis

theorem areMutuallyCommuting_eq_true_iff {m : ℕ}
    (paulis : List (DensePauli m)) :
    areMutuallyCommuting paulis = true ↔
      paulis.Pairwise fun left right =>
        ProjectivePauli.commutationPairing
          left.decode.projective right.decode.projective = 0 := by
  induction paulis with
  | nil => simp [areMutuallyCommuting]
  | cons pauli paulis induction =>
      simp [areMutuallyCommuting, induction,
        DensePauli.commutes_eq_true_iff]

/-! ## Pauli-exponential and root-Pauli updates -/

namespace Pauli

variable {m : ℕ}

/-- Add a scalar phase without changing projective coordinates. -/
def addPhase (pauli : Pauli m) (phase : PauliPhase) : Pauli m :=
  ofProjective pauli.projective (pauli.phase + phase)

@[simp]
theorem projective_addPhase (pauli : Pauli m) (phase : PauliPhase) :
    (addPhase pauli phase).projective = pauli.projective := rfl

@[simp]
theorem phase_addPhase (pauli : Pauli m) (phase : PauliPhase) :
    (addPhase pauli phase).phase = pauli.phase + phase := rfl

/-- Branchwise semantic update implemented by Rust's `apply_pauli_exponent`. -/
def exponentAction (target exponent : Pauli m) : Pauli m :=
  if ProjectivePauli.commutationPairing
      target.projective exponent.projective = 0
  then target
  else addPhase (exponent * target) 1

/-- Shifting a negated Pauli by `i` equals shifting the original by `-i`. -/
theorem addPhase_neg_one (pauli : Pauli m) :
    addPhase (-pauli) 1 = addPhase pauli 3 := by
  apply Pauli.ext
  · rfl
  · rfl
  · simp only [phase_addPhase, phase_neg]
    ring

theorem addPhase_neg_mul_one
    (generator target : Pauli m) :
    addPhase ((-generator) * target) 1 =
      addPhase (generator * target) 3 := by
  rw [neg_mul, addPhase_neg_one]

theorem exponentAction_neg_singleX
    (target : Pauli m) (index : Fin m) :
    exponentAction target
        (-(ofProjective (ProjectivePauli.singleX index) 0)) =
      if target.z index = 0 then
        target
      else
        addPhase
          (ofProjective (ProjectivePauli.singleX index) 0 *
            target) 3 := by
  by_cases commutes : target.z index = 0
  · have projective_commutes :
        target.projective.z index = 0 := by
      simpa [projective] using commutes
    simp [exponentAction, commutes, projective_commutes]
  · have projective_commutes :
        target.projective.z index ≠ 0 := by
      simpa [projective] using commutes
    simp [exponentAction, commutes, projective_commutes,
      addPhase_neg_one]

theorem commutationPairing_singleY_eq_zero_iff
    (target : Pauli m) (index : Fin m) :
    ProjectivePauli.commutationPairing target.projective
        (ProjectivePauli.singleX index +
          ProjectivePauli.singleZ index) = 0 ↔
      target.x index = target.z index := by
  rw [ProjectivePauli.commutationPairing_add_right,
    ProjectivePauli.commutationPairing_singleX,
    ProjectivePauli.commutationPairing_singleZ]
  change target.z index + target.x index = 0 ↔
    target.x index = target.z index
  constructor
  · intro sum_zero
    calc
      target.x index = 0 + target.x index :=
        (zero_add _).symm
      _ = (target.z index + target.x index) +
          target.x index := by rw [sum_zero]
      _ = target.z index +
          (target.x index + target.x index) := by abel
      _ = target.z index := by
        rw [f2_add_self, add_zero]
  · intro equal
    rw [equal, f2_add_self]

theorem exponentAction_neg_singleY
    (target : Pauli m) (index : Fin m) :
    exponentAction target
        (-positiveRepresentative
          (ProjectivePauli.singleX index +
            ProjectivePauli.singleZ index)) =
      if target.x index = target.z index then
        target
      else
        addPhase
          (positiveRepresentative
              (ProjectivePauli.singleX index +
                ProjectivePauli.singleZ index) *
            target) 3 := by
  by_cases commutes : target.x index = target.z index
  · have pairing :
      ProjectivePauli.commutationPairing target.projective
          (ProjectivePauli.singleX index +
            ProjectivePauli.singleZ index) = 0 :=
      (commutationPairing_singleY_eq_zero_iff target index).mpr
        commutes
    simp [exponentAction, commutes, pairing]
  · have pairing :
      ProjectivePauli.commutationPairing target.projective
          (ProjectivePauli.singleX index +
            ProjectivePauli.singleZ index) ≠ 0 := by
      exact fun equal =>
        commutes
          ((commutationPairing_singleY_eq_zero_iff
            target index).mp equal)
    simp [exponentAction, commutes, pairing,
      addPhase_neg_one]

theorem exponentAction_neg_singleZ
    (target : Pauli m) (index : Fin m) :
    exponentAction target
        (-(ofProjective (ProjectivePauli.singleZ index) 0)) =
      if target.x index = 0 then
        target
      else
        addPhase
          (ofProjective (ProjectivePauli.singleZ index) 0 *
            target) 3 := by
  by_cases commutes : target.x index = 0
  · have projective_commutes :
        target.projective.x index = 0 := by
      simpa [projective] using commutes
    simp [exponentAction, commutes, projective_commutes]
  · have projective_commutes :
        target.projective.x index ≠ 0 := by
      simpa [projective] using commutes
    simp [exponentAction, commutes, projective_commutes,
      addPhase_neg_one]

end Pauli

namespace DensePauli

variable {m : ℕ}

/-- Packed implementation of `apply_pauli_exponent`. -/
def applyPauliExponent
    (target exponent : DensePauli m) : DensePauli m :=
  if target.antiCommutes exponent then
    (exponent * target).addPhase 1
  else
    target

@[simp]
theorem decode_applyPauliExponent
    (target exponent : DensePauli m) :
    (applyPauliExponent target exponent).decode =
      Pauli.exponentAction target.decode exponent.decode := by
  by_cases anticommutes : target.antiCommutes exponent = true
  · have pairing :
      ProjectivePauli.commutationPairing
        target.decode.projective exponent.decode.projective = 1 :=
      (antiCommutes_eq_true_iff target exponent).mp anticommutes
    simp [applyPauliExponent, anticommutes,
      Pauli.exponentAction, pairing, Pauli.addPhase]
  · have false_eq : target.antiCommutes exponent = false := by
      exact Bool.eq_false_of_not_eq_true anticommutes
    have pairing :
      ProjectivePauli.commutationPairing
        target.decode.projective exponent.decode.projective = 0 :=
      (antiCommutes_eq_false_iff target exponent).mp false_eq
    simp [applyPauliExponent, false_eq,
      Pauli.exponentAction, pairing]

/-- Packed implementation of `apply_root_x`. -/
def applyRootX (target : DensePauli m) (index : Fin m) :
    DensePauli m :=
  if target.zBits.get index.val then
    (target.multiplyLeftX index).addPhase 3
  else
    target

/-- Packed implementation of `apply_root_y`. -/
def applyRootY (target : DensePauli m) (index : Fin m) :
    DensePauli m :=
  if target.zBits.get index.val ^^ target.xBits.get index.val then
    (target.multiplyLeftY index).addPhase 3
  else
    target

/-- Packed implementation of `apply_root_z`. -/
def applyRootZ (target : DensePauli m) (index : Fin m) :
    DensePauli m :=
  if target.xBits.get index.val then
    (target.multiplyLeftZ index).addPhase 3
  else
    target

@[simp]
theorem decode_applyRootX (target : DensePauli m) (index : Fin m) :
    (applyRootX target index).decode =
      if target.decode.z index = 0 then
        target.decode
      else
        Pauli.addPhase
          (Pauli.ofProjective (ProjectivePauli.singleX index) 0 *
            target.decode) 3 := by
  cases bit : target.zBits.get index.val
  · have coordinate : target.decode.z index = 0 := by
      simp [DensePauli.decode, bit]
    simp [applyRootX, bit, coordinate]
  · have coordinate : target.decode.z index = 1 := by
      simp [DensePauli.decode, bit]
    simp [applyRootX, bit, coordinate]
    rfl

@[simp]
theorem decode_applyRootY (target : DensePauli m) (index : Fin m) :
    (applyRootY target index).decode =
      if target.decode.x index = target.decode.z index then
        target.decode
      else
        Pauli.addPhase
          (Pauli.positiveRepresentative
              (ProjectivePauli.singleX index +
                ProjectivePauli.singleZ index) *
            target.decode) 3 := by
  cases x_bit : target.xBits.get index.val <;>
    cases z_bit : target.zBits.get index.val
  · have x_coordinate : target.decode.x index = 0 := by
      simp [DensePauli.decode, x_bit]
    have z_coordinate : target.decode.z index = 0 := by
      simp [DensePauli.decode, z_bit]
    simp [applyRootY, x_bit, z_bit, x_coordinate,
      z_coordinate]
  · have x_coordinate : target.decode.x index = 0 := by
      simp [DensePauli.decode, x_bit]
    have z_coordinate : target.decode.z index = 1 := by
      simp [DensePauli.decode, z_bit]
    simp [applyRootY, x_bit, z_bit, x_coordinate,
      z_coordinate]
    apply Pauli.ext
    · rfl
    · rfl
    · simp
      rfl
  · have x_coordinate : target.decode.x index = 1 := by
      simp [DensePauli.decode, x_bit]
    have z_coordinate : target.decode.z index = 0 := by
      simp [DensePauli.decode, z_bit]
    simp [applyRootY, x_bit, z_bit, x_coordinate,
      z_coordinate]
    apply Pauli.ext
    · rfl
    · rfl
    · simp
      rfl
  · have x_coordinate : target.decode.x index = 1 := by
      simp [DensePauli.decode, x_bit]
    have z_coordinate : target.decode.z index = 1 := by
      simp [DensePauli.decode, z_bit]
    simp [applyRootY, x_bit, z_bit, x_coordinate,
      z_coordinate]

@[simp]
theorem decode_applyRootZ (target : DensePauli m) (index : Fin m) :
    (applyRootZ target index).decode =
      if target.decode.x index = 0 then
        target.decode
      else
        Pauli.addPhase
          (Pauli.ofProjective (ProjectivePauli.singleZ index) 0 *
            target.decode) 3 := by
  cases bit : target.xBits.get index.val
  · have coordinate : target.decode.x index = 0 := by
      simp [DensePauli.decode, bit]
    simp [applyRootZ, bit, coordinate]
  · have coordinate : target.decode.x index = 1 := by
      simp [DensePauli.decode, bit]
    simp [applyRootZ, bit, coordinate]
    rfl

theorem applyRootX_eq_applyPauliExponent
    (target : DensePauli m) (index : Fin m) :
    applyRootX target index =
      applyPauliExponent target (singleX index).negate := by
  apply DensePauli.decode_injective
  rw [decode_applyRootX, decode_applyPauliExponent,
    decode_negate, decode_singleX,
    Pauli.exponentAction_neg_singleX]

theorem applyRootY_eq_applyPauliExponent
    (target : DensePauli m) (index : Fin m) :
    applyRootY target index =
      applyPauliExponent target (singleY index).negate := by
  apply DensePauli.decode_injective
  rw [decode_applyRootY, decode_applyPauliExponent,
    decode_negate, decode_singleY,
    Pauli.exponentAction_neg_singleY]

theorem applyRootZ_eq_applyPauliExponent
    (target : DensePauli m) (index : Fin m) :
    applyRootZ target index =
      applyPauliExponent target (singleZ index).negate := by
  apply DensePauli.decode_injective
  rw [decode_applyRootZ, decode_applyPauliExponent,
    decode_negate, decode_singleZ,
    Pauli.exponentAction_neg_singleZ]

end DensePauli

end PaulimerFormal
