import PaulimerFormal.PauliAlgorithms

/-!
# Pauli subgroup standardization

This module connects BinarFormal's verified row transform to phase-aware Pauli
products. It first proves the projective correctness of the transformed
generators; central-phase normalization is handled separately below.
-/

namespace PaulimerFormal

open BinarFormal.Echelon
open BinarFormal.Packed

variable {m : ℕ}

/-- Semantic phase-aware subgroup generated by packed Pauli inputs. -/
def generatedPauliGroup (generators : List (DensePauli m)) :
    Subgroup (Pauli m) :=
  Subgroup.closure
    (Set.range fun index : Fin generators.length =>
      generators[index].decode)

theorem DensePauli.decode_mem_generatedPauliGroup
    (generators : List (DensePauli m))
    (index : Fin generators.length) :
    generators[index].decode ∈ generatedPauliGroup generators :=
  Subgroup.subset_closure (Set.mem_range_self index)

@[simp]
theorem Pauli.projectiveRow_one :
    (1 : Pauli m).projectiveRow = 0 := by
  funext column
  refine Fin.addCases ?_ ?_ column <;> intro index
  · rw [Pauli.projectiveRow_x]
    rfl
  · rw [Pauli.projectiveRow_z]
    rfl

@[simp]
theorem Pauli.projectiveRow_mul (left right : Pauli m) :
    (left * right).projectiveRow =
      left.projectiveRow + right.projectiveRow := by
  funext column
  refine Fin.addCases ?_ ?_ column <;> intro index
  · simp only [Pi.add_apply,
      Pauli.projectiveRow_x]
    rfl
  · simp only [Pi.add_apply,
      Pauli.projectiveRow_z]
    rfl

@[simp]
theorem Pauli.projectiveRow_inv (pauli : Pauli m) :
    pauli⁻¹.projectiveRow = pauli.projectiveRow := by
  funext column
  refine Fin.addCases ?_ ?_ column <;> intro index
  · rw [Pauli.projectiveRow_x,
      Pauli.projectiveRow_x]
    rfl
  · rw [Pauli.projectiveRow_z,
      Pauli.projectiveRow_z]
    rfl

@[simp]
theorem Pauli.projectiveRow_list_prod
    (paulis : List (Pauli m)) :
    paulis.prod.projectiveRow =
      (paulis.map Pauli.projectiveRow).sum := by
  induction paulis with
  | nil => simp
  | cons pauli paulis induction =>
      simp [induction]

/-- Ordered product selected by one binary coefficient row. -/
def selectedPauliProduct
    (generators : List (DensePauli m))
    (coefficients : Fin generators.length → F2) :
    Pauli m :=
  (List.ofFn fun index =>
    if coefficients index = 0 then
      1
    else
      generators[index].decode).prod

theorem selectedPauliProduct_mem_generatedPauliGroup
    (generators : List (DensePauli m))
    (coefficients : Fin generators.length → F2) :
    selectedPauliProduct generators coefficients ∈
      generatedPauliGroup generators := by
  apply Subgroup.list_prod_mem
  rw [List.forall_mem_ofFn_iff]
  intro index
  by_cases zero : coefficients index = 0
  · simp [zero]
  · rw [ite_eq_right zero]
    exact
      DensePauli.decode_mem_generatedPauliGroup
        generators index

@[simp]
theorem selectedPauliProduct_zero
    (generators : List (DensePauli m)) :
    selectedPauliProduct generators 0 = 1 := by
  simp [selectedPauliProduct]

@[simp]
theorem selectedPauliProduct_single
    (generators : List (DensePauli m))
    (index : Fin generators.length) :
    selectedPauliProduct generators
        (Pi.single index 1) =
      generators[index].decode := by
  rw [selectedPauliProduct, List.ofFn_eq_map,
    List.prod_map_eq_pow_single index]
  · simp
  · intro other not_equal _
    rw [Pi.single_eq_of_ne not_equal]
    simp

theorem selectedPauliProduct_projectiveRow
    (generators : List (DensePauli m))
    (coefficients : Fin generators.length → F2) :
    (selectedPauliProduct generators coefficients).projectiveRow =
      Matrix.vecMul coefficients
        (bitMatrixFromPaulis generators).decode := by
  rw [selectedPauliProduct,
    Pauli.projectiveRow_list_prod,
    List.map_ofFn, List.sum_ofFn]
  funext column
  simp only [Finset.sum_apply, Matrix.vecMul, dotProduct]
  apply Finset.sum_congr rfl
  intro index _
  change
    (if coefficients index = 0 then
        (1 : Pauli m)
      else
        generators[index].decode).projectiveRow column =
      coefficients index *
        (bitMatrixFromPaulis generators).decode index column
  rcases Pauli.f2_eq_zero_or_one
      (coefficients index) with zero | one
  · rw [zero]
    simp
  · rw [one]
    simpa [PackedMatrix.decode_get] using
      congrFun
        (decode_bitMatrixFromPaulis_row
          generators index).symm column

/-- Phase-aware product represented by one row of Binar's transform. -/
def echelonPauliProduct
    (generators : List (DensePauli m))
    (row : Fin generators.length) :
    Pauli m :=
  selectedPauliProduct generators
    ((EchelonForm.new
      (bitMatrixFromPaulis generators)).transform.decode row)

theorem echelonPauliProduct_mem_generatedPauliGroup
    (generators : List (DensePauli m))
    (row : Fin generators.length) :
    echelonPauliProduct generators row ∈
      generatedPauliGroup generators :=
  selectedPauliProduct_mem_generatedPauliGroup _ _

theorem echelonPauliProduct_projectiveRow
    (generators : List (DensePauli m))
    (row : Fin generators.length) :
    (echelonPauliProduct generators row).projectiveRow =
      (EchelonForm.new
        (bitMatrixFromPaulis generators)).matrix.decode row := by
  rw [echelonPauliProduct,
    selectedPauliProduct_projectiveRow]
  change
    (((EchelonForm.new
        (bitMatrixFromPaulis generators)).transform.decode *
      (bitMatrixFromPaulis generators).decode) row) =
      _
  rw [EchelonForm.new_transform_mul_eq]

/-- Subgroup generated by all phase-aware transform-row products. -/
def echelonPauliGroup
    (generators : List (DensePauli m)) :
    Subgroup (Pauli m) :=
  Subgroup.closure
    (Set.range (echelonPauliProduct generators))

theorem echelonPauliGroup_le_generatedPauliGroup
    (generators : List (DensePauli m)) :
    echelonPauliGroup generators ≤
      generatedPauliGroup generators := by
  rw [echelonPauliGroup, Subgroup.closure_le]
  rintro _ ⟨row, rfl⟩
  exact echelonPauliProduct_mem_generatedPauliGroup _ row

theorem exists_mem_echelonPauliGroup_projectiveRow_eq
    (generators : List (DensePauli m))
    {vector : Fin (m + m) → F2}
    (member :
      vector ∈
        Submodule.span F2
          (Set.range
            (EchelonForm.new
              (bitMatrixFromPaulis generators)).matrix.decode)) :
    ∃ pauli,
      pauli ∈ echelonPauliGroup generators ∧
      pauli.projectiveRow = vector := by
  induction member using Submodule.span_induction with
  | mem vector member =>
      rcases member with ⟨row, rfl⟩
      exact
        ⟨echelonPauliProduct generators row,
          Subgroup.subset_closure (Set.mem_range_self row),
          echelonPauliProduct_projectiveRow generators row⟩
  | zero =>
      exact ⟨1, Subgroup.one_mem _, Pauli.projectiveRow_one⟩
  | add left right _ _ left_exists right_exists =>
      rcases left_exists with ⟨left_pauli, left_member, left_row⟩
      rcases right_exists with
        ⟨right_pauli, right_member, right_row⟩
      exact
        ⟨left_pauli * right_pauli,
          Subgroup.mul_mem _ left_member right_member,
          by rw [Pauli.projectiveRow_mul,
            left_row, right_row]⟩
  | smul scalar vector _ exists_pauli =>
      rcases Pauli.f2_eq_zero_or_one scalar with zero | one
      · rw [zero, zero_smul]
        exact
          ⟨1, Subgroup.one_mem _,
            Pauli.projectiveRow_one⟩
      · rw [one, one_smul]
        exact exists_pauli

theorem generatedPauliGroup_projectiveRow_mem
    (generators : List (DensePauli m))
    {pauli : Pauli m}
    (member : pauli ∈ generatedPauliGroup generators) :
    pauli.projectiveRow ∈ projectiveSpan generators := by
  induction member using Subgroup.closure_induction with
  | mem pauli member =>
      rcases member with ⟨index, rfl⟩
      rw [projectiveSpan]
      exact
        Submodule.subset_span
          (Set.mem_range_self index)
  | one =>
      simp [projectiveSpan]
  | mul left right _ _ left_member right_member =>
      rw [Pauli.projectiveRow_mul]
      exact Submodule.add_mem _ left_member right_member
  | inv pauli _ member =>
      rw [Pauli.projectiveRow_inv]
      exact member

theorem exists_mem_echelonPauliGroup_same_projectiveRow
    (generators : List (DensePauli m))
    {pauli : Pauli m}
    (member : pauli ∈ generatedPauliGroup generators) :
    ∃ transformed,
      transformed ∈ echelonPauliGroup generators ∧
      transformed.projectiveRow = pauli.projectiveRow := by
  apply
    exists_mem_echelonPauliGroup_projectiveRow_eq
      generators
  rw [EchelonForm.new_rowSpace_eq]
  rw [bitMatrixFromPaulis_rowSpace]
  exact generatedPauliGroup_projectiveRow_mem
    generators member

/-! ## Scalar phase kernel -/

namespace Pauli

/-- Scalar phase `i^phase I`. -/
def scalar (phase : PauliPhase) : Pauli m :=
  ofProjective 0 phase

@[simp]
theorem projective_scalar (phase : PauliPhase) :
    (scalar (m := m) phase).projective = 0 := rfl

@[simp]
theorem phase_scalar (phase : PauliPhase) :
    (scalar (m := m) phase).phase = phase := rfl

@[simp]
theorem projectiveRow_scalar
    (phase : PauliPhase) :
    (scalar (m := m) phase).projectiveRow = 0 := by
  funext column
  refine Fin.addCases ?_ ?_ column <;>
    intro index
  · rw [Pauli.projectiveRow_x]
    rfl
  · rw [Pauli.projectiveRow_z]
    rfl

@[simp]
theorem scalar_zero :
    scalar (m := m) 0 = 1 := rfl

@[simp]
theorem scalar_add (left right : PauliPhase) :
    scalar (m := m) (left + right) =
      scalar left * scalar right := by
  apply Pauli.ext
  · rfl
  · rfl
  · simp [scalar, ofProjective,
      projective, ProjectivePauli.xzCross,
      dotProduct]

@[simp]
theorem scalar_neg (phase : PauliPhase) :
    scalar (m := m) (-phase) =
      (scalar phase)⁻¹ := by
  apply Pauli.ext
  · rfl
  · rfl
  · simp [scalar, ofProjective,
      projective, ProjectivePauli.xzCross,
      dotProduct]

theorem eq_scalar_phase_of_projective_eq_zero
    (pauli : Pauli m)
    (projective_zero : pauli.projective = 0) :
    pauli = scalar pauli.phase := by
  apply Pauli.ext
  · exact congrArg ProjectivePauli.x projective_zero
  · exact congrArg ProjectivePauli.z projective_zero
  · rfl

theorem projective_eq_of_projectiveRow_eq
    {left right : Pauli m}
    (rows_equal :
      left.projectiveRow = right.projectiveRow) :
    left.projective = right.projective := by
  have phase_vectors_equal :
      left.projective.toPhaseVector =
        right.projective.toPhaseVector := by
    simpa [Pauli.projectiveRow] using
      congrArg
        (BinarBridge.ofFinVector (m := m))
        rows_equal
  apply ProjectivePauli.ext <;> funext index
  · exact
      congrFun phase_vectors_equal (Sum.inl index)
  · exact
      congrFun phase_vectors_equal (Sum.inr index)

end Pauli

@[simp]
theorem ProjectivePauli.add_self_eq_zero
    (pauli : ProjectivePauli m) :
    pauli + pauli = 0 := by
  apply ProjectivePauli.ext <;> funext index
  · exact f2_add_self (pauli.x index)
  · exact f2_add_self (pauli.z index)

/-- Scalar phases contained in a phase-aware Pauli subgroup. -/
def scalarPhases (group : Subgroup (Pauli m)) :
    AddSubgroup PauliPhase where
  carrier :=
    {phase |
      Pauli.scalar (m := m) phase ∈ group}
  zero_mem' := by simp
  add_mem' := by
    intro left right left_mem right_mem
    change
      Pauli.scalar (m := m) (left + right) ∈ group
    change Pauli.scalar (m := m) left ∈ group at left_mem
    change Pauli.scalar (m := m) right ∈ group at right_mem
    rw [Pauli.scalar_add]
    exact group.mul_mem left_mem right_mem
  neg_mem' := by
    intro phase member
    change
      Pauli.scalar (m := m) (-phase) ∈ group
    change Pauli.scalar (m := m) phase ∈ group at member
    rw [Pauli.scalar_neg]
    exact group.inv_mem member

/-- Scalar Paulis whose phases lie in the selected additive phase subgroup. -/
def scalarPauliSubgroup
    (phases : AddSubgroup PauliPhase) :
    Subgroup (Pauli m) where
  carrier :=
    {pauli |
      pauli.projective = 0 ∧
        pauli.phase ∈ phases}
  one_mem' := by simp
  mul_mem' := by
    intro left right left_mem right_mem
    constructor
    · rw [Pauli.projective_mul,
        left_mem.1, right_mem.1, add_zero]
    · simpa [left_mem.1, right_mem.1,
        ProjectivePauli.xzCross] using
        phases.add_mem left_mem.2 right_mem.2
  inv_mem' := by
    intro pauli member
    constructor
    · simp [member.1]
    · simpa [member.1,
        ProjectivePauli.xzCross] using
        phases.neg_mem member.2

@[simp]
theorem Pauli.scalar_mem_scalarPauliSubgroup
    (phases : AddSubgroup PauliPhase)
    (phase : PauliPhase) :
    Pauli.scalar (m := m) phase ∈
        scalarPauliSubgroup phases ↔
      phase ∈ phases := by
  simp [scalarPauliSubgroup]

theorem scalarPauliSubgroup_le_group
    (group : Subgroup (Pauli m)) :
    scalarPauliSubgroup (scalarPhases group) ≤
      group := by
  intro pauli member
  have equals_scalar :=
    Pauli.eq_scalar_phase_of_projective_eq_zero
      pauli member.1
  rw [equals_scalar]
  exact member.2

noncomputable def phaseRepresentatives
    (phases : AddSubgroup PauliPhase) :
    List PauliPhase := by
  classical
  exact
    if (1 : PauliPhase) ∈ phases then
      [0, 1, 2, 3]
    else if (2 : PauliPhase) ∈ phases then
      [0, 2]
    else
      [0]

theorem pauliPhase_eq_zero_or_one_or_two_or_three
    (phase : PauliPhase) :
    phase = 0 ∨ phase = 1 ∨
      phase = 2 ∨ phase = 3 := by
  fin_cases phase
  · exact Or.inl rfl
  · exact Or.inr (Or.inl rfl)
  · exact Or.inr (Or.inr (Or.inl rfl))
  · exact Or.inr (Or.inr (Or.inr rfl))

theorem mem_phaseRepresentatives_iff
    (phases : AddSubgroup PauliPhase)
    (phase : PauliPhase) :
    phase ∈ phaseRepresentatives phases ↔
      phase ∈ phases := by
  classical
  by_cases one_mem : (1 : PauliPhase) ∈ phases
  · have two_mem : (2 : PauliPhase) ∈ phases := by
      have := phases.add_mem one_mem one_mem
      rw [show (1 + 1 : PauliPhase) = 2 by decide] at this
      exact this
    have three_mem : (3 : PauliPhase) ∈ phases := by
      have := phases.add_mem two_mem one_mem
      rw [show (2 + 1 : PauliPhase) = 3 by decide] at this
      exact this
    simp only [phaseRepresentatives, one_mem, ↓reduceIte]
    rcases
        pauliPhase_eq_zero_or_one_or_two_or_three
          phase with
      phase_zero | phase_one | phase_two | phase_three
    · subst phase
      constructor
      · intro _
        exact phases.zero_mem
      · intro _
        decide
    · subst phase
      constructor
      · intro _
        exact one_mem
      · intro _
        decide
    · subst phase
      constructor
      · intro _
        exact two_mem
      · intro _
        decide
    · subst phase
      constructor
      · intro _
        exact three_mem
      · intro _
        decide
  · have three_not : (3 : PauliPhase) ∉ phases := by
      intro three_mem
      apply one_mem
      have := phases.neg_mem three_mem
      rw [show (-(3 : PauliPhase)) = 1 by decide] at this
      exact this
    by_cases two_mem : (2 : PauliPhase) ∈ phases
    · simp only [phaseRepresentatives, one_mem,
        two_mem, ↓reduceIte]
      rcases
          pauliPhase_eq_zero_or_one_or_two_or_three
            phase with
        phase_zero | phase_one | phase_two | phase_three
      · subst phase
        constructor
        · intro _
          exact phases.zero_mem
        · intro _
          decide
      · subst phase
        constructor
        · intro list_mem
          exact
            False.elim
              ((by decide :
                (1 : PauliPhase) ∉ [0, 2])
                list_mem)
        · intro member
          exact (one_mem member).elim
      · subst phase
        constructor
        · intro _
          exact two_mem
        · intro _
          decide
      · subst phase
        constructor
        · intro list_mem
          exact
            False.elim
              ((by decide :
                (3 : PauliPhase) ∉ [0, 2])
                list_mem)
        · intro member
          exact (three_not member).elim
    · simp only [phaseRepresentatives, one_mem,
        two_mem, ↓reduceIte]
      rcases
          pauliPhase_eq_zero_or_one_or_two_or_three
            phase with
        phase_zero | phase_one | phase_two | phase_three
      · subst phase
        constructor
        · intro _
          exact phases.zero_mem
        · intro _
          decide
      · subst phase
        constructor
        · intro list_mem
          exact
            False.elim
              ((by decide :
                (1 : PauliPhase) ∉ [0])
                list_mem)
        · intro member
          exact (one_mem member).elim
      · subst phase
        constructor
        · intro list_mem
          exact
            False.elim
              ((by decide :
                (2 : PauliPhase) ∉ [0])
                list_mem)
        · intro member
          exact (two_mem member).elim
      · subst phase
        constructor
        · intro list_mem
          exact
            False.elim
              ((by decide :
                (3 : PauliPhase) ∉ [0])
                list_mem)
        · intro member
          exact (three_not member).elim

noncomputable def scalarPhaseRank
    (phases : AddSubgroup PauliPhase) : ℕ := by
  classical
  exact
    if (1 : PauliPhase) ∈ phases then
      2
    else if (2 : PauliPhase) ∈ phases then
      1
    else
      0

theorem phaseRepresentatives_length
    (phases : AddSubgroup PauliPhase) :
    (phaseRepresentatives phases).length =
      2 ^ scalarPhaseRank phases := by
  classical
  by_cases one_mem : (1 : PauliPhase) ∈ phases
  · simp [phaseRepresentatives,
      scalarPhaseRank, one_mem]
  · by_cases two_mem : (2 : PauliPhase) ∈ phases
    · simp [phaseRepresentatives,
        scalarPhaseRank, one_mem, two_mem]
    · simp [phaseRepresentatives,
        scalarPhaseRank, one_mem, two_mem]

/-! ## Phase parity -/

/-- Reduction of a Pauli phase exponent modulo two. -/
def phaseParity : PauliPhase →+ F2 :=
  (ZMod.castHom (by decide : 2 ∣ 4) F2).toAddMonoidHom

@[simp]
theorem phaseParity_zero :
    phaseParity (0 : PauliPhase) = 0 := by
  exact map_zero phaseParity

@[simp]
theorem phaseParity_one :
    phaseParity (1 : PauliPhase) = 1 := by
  rfl

@[simp]
theorem phaseParity_two :
    phaseParity (2 : PauliPhase) = 0 := by
  rfl

@[simp]
theorem phaseParity_three :
    phaseParity (3 : PauliPhase) = 1 := by
  rfl

@[simp]
theorem phaseParity_parityPhase (bit : F2) :
    phaseParity (Pauli.parityPhase bit) = 0 := by
  fin_cases bit <;> decide

@[simp]
theorem phaseParity_phase_one :
    phaseParity (1 : Pauli m).phase = 0 := by
  rw [Pauli.phase_one, map_zero]

@[simp]
theorem phaseParity_phase_mul
    (left right : Pauli m) :
    phaseParity (left * right).phase =
      phaseParity left.phase +
        phaseParity right.phase := by
  rw [Pauli.phase_mul, map_add, map_add,
    phaseParity_parityPhase, add_zero]

@[simp]
theorem phaseParity_phase_inv
    (pauli : Pauli m) :
    phaseParity pauli⁻¹.phase =
      phaseParity pauli.phase := by
  rw [Pauli.phase_inv, map_add,
    map_neg, phaseParity_parityPhase, add_zero]
  exact f2_neg _

namespace Pauli

@[simp]
theorem scalar_two_mul (pauli : Pauli m) :
    scalar (m := m) 2 * pauli = -pauli := by
  have projective_equal :
      (scalar (m := m) 2 * pauli).projective =
        (-pauli).projective := by
    simp
  apply Pauli.ext
  · exact congrArg ProjectivePauli.x projective_equal
  · exact congrArg ProjectivePauli.z projective_equal
  · simp [scalar, ofProjective, projective,
      ProjectivePauli.xzCross, dotProduct]
    abel

@[simp]
theorem neg_one_eq_scalar_two :
    -(1 : Pauli m) = scalar 2 := by
  apply Pauli.ext <;> rfl

theorem square_eq_one_or_scalar_two
    (pauli : Pauli m) :
    pauli * pauli = 1 ∨
      pauli * pauli = scalar 2 := by
  have projective_zero :
      (pauli * pauli).projective = 0 := by
    rw [projective_mul,
      ProjectivePauli.add_self_eq_zero]
  have phase_even :
      (pauli * pauli).phase = 0 ∨
        (pauli * pauli).phase = 2 := by
    rw [phase_mul]
    generalize pauli.phase = phase
    generalize
      ProjectivePauli.xzCross
        pauli.projective pauli.projective = bit
    fin_cases phase <;> fin_cases bit <;> decide
  have equals_scalar :=
    eq_scalar_phase_of_projective_eq_zero
      (pauli * pauli) projective_zero
  rcases phase_even with phase_zero | phase_two
  · left
    rw [equals_scalar, phase_zero, scalar_zero]
  · right
    rw [equals_scalar, phase_two]

end Pauli

theorem scalar_two_mem_of_anticommutes
    (group : Subgroup (Pauli m))
    {left right : Pauli m}
    (left_mem : left ∈ group)
    (right_mem : right ∈ group)
    (anticommutes :
      ProjectivePauli.commutationPairing
        left.projective right.projective = 1) :
    Pauli.scalar (m := m) 2 ∈ group := by
  have commutator_mem :
      Pauli.conjugate left right * right⁻¹ ∈ group := by
    apply group.mul_mem
    · exact
        group.mul_mem
          (group.mul_mem left_mem right_mem)
          (group.inv_mem left_mem)
    · exact group.inv_mem right_mem
  rw [Pauli.conjugate_eq_neg_of_commutationPairing_eq_one
      left right anticommutes,
    Pauli.neg_mul] at commutator_mem
  simpa using commutator_mem

theorem scalar_two_mem_of_not_isOrderTwo
    (group : Subgroup (Pauli m))
    {pauli : Pauli m}
    (member : pauli ∈ group)
    (not_order_two : ¬Pauli.IsOrderTwo pauli) :
    Pauli.scalar (m := m) 2 ∈ group := by
  rcases Pauli.square_eq_one_or_scalar_two pauli with
    square_one | square_two
  · exact (not_order_two square_one).elim
  · rw [← square_two]
    exact group.mul_mem member member

/-! ## Binary combinations of generators -/

def generatorProjectiveCombination
    (generators : List (DensePauli m))
    (coefficients : Fin generators.length → F2) :
    Fin (m + m) → F2 :=
  ∑ index,
    coefficients index •
      generators[index].decode.projectiveRow

def generatorPhaseParityCombination
    (generators : List (DensePauli m))
    (coefficients : Fin generators.length → F2) :
    F2 :=
  ∑ index,
    coefficients index *
      phaseParity generators[index].decode.phase

theorem generatorProjectiveCombination_eq_vecMul
    (generators : List (DensePauli m))
    (coefficients : Fin generators.length → F2) :
    generatorProjectiveCombination generators coefficients =
      Matrix.vecMul coefficients
        (bitMatrixFromPaulis generators).decode := by
  funext column
  simp only [generatorProjectiveCombination,
    Finset.sum_apply, Pi.smul_apply, smul_eq_mul,
    Matrix.vecMul, dotProduct]
  apply Finset.sum_congr rfl
  intro index _
  rw [← congrFun
    (decode_bitMatrixFromPaulis_row generators index)
    column]

@[simp]
theorem phaseParity_list_prod
    (paulis : List (Pauli m)) :
    phaseParity paulis.prod.phase =
      (paulis.map fun pauli =>
        phaseParity pauli.phase).sum := by
  induction paulis with
  | nil => simp
  | cons pauli paulis induction =>
      simp [induction]

theorem selectedPauliProduct_phaseParity
    (generators : List (DensePauli m))
    (coefficients : Fin generators.length → F2) :
    phaseParity
        (selectedPauliProduct
          generators coefficients).phase =
      generatorPhaseParityCombination
        generators coefficients := by
  classical
  rw [selectedPauliProduct,
    phaseParity_list_prod, List.map_ofFn,
    List.sum_ofFn,
    generatorPhaseParityCombination]
  apply Finset.sum_congr rfl
  intro index _
  change
    phaseParity
          (if coefficients index = 0 then
            (1 : Pauli m)
          else
            generators[index].decode).phase =
      coefficients index *
        phaseParity generators[index].decode.phase
  rcases Pauli.f2_eq_zero_or_one
      (coefficients index) with zero | one
  · rw [ite_eq_left zero, zero, zero_mul,
      phaseParity_phase_one]
  · have nonzero : coefficients index ≠ 0 := by
      rw [one]
      exact one_ne_zero
    rw [ite_eq_right nonzero, one, one_mul]

theorem generatedPauliGroup_has_binary_combination
    (generators : List (DensePauli m))
    {pauli : Pauli m}
    (member : pauli ∈ generatedPauliGroup generators) :
    ∃ coefficients : Fin generators.length → F2,
      pauli.projectiveRow =
          generatorProjectiveCombination
            generators coefficients ∧
        phaseParity pauli.phase =
          generatorPhaseParityCombination
            generators coefficients := by
  induction member using Subgroup.closure_induction with
  | mem pauli pauli_mem =>
      rcases pauli_mem with ⟨index, rfl⟩
      refine ⟨Pi.single index 1, ?_, ?_⟩
      · classical
        simp [generatorProjectiveCombination]
      · classical
        rw [generatorPhaseParityCombination,
          Finset.sum_eq_single index]
        · rw [Pi.single_eq_same, one_mul]
        · intro other _ not_equal
          rw [Pi.single_eq_of_ne not_equal,
            zero_mul]
        · intro not_mem
          exact (not_mem (Finset.mem_univ index)).elim
  | one =>
      refine ⟨0, ?_, ?_⟩
      · simp [generatorProjectiveCombination]
      · simp [generatorPhaseParityCombination]
  | mul left right _ _ left_exists right_exists =>
      rcases left_exists with
        ⟨left_coefficients, left_row, left_phase⟩
      rcases right_exists with
        ⟨right_coefficients, right_row, right_phase⟩
      refine
        ⟨left_coefficients + right_coefficients,
          ?_, ?_⟩
      · rw [Pauli.projectiveRow_mul,
          left_row, right_row]
        classical
        simp [generatorProjectiveCombination,
          add_smul, Finset.sum_add_distrib]
      · rw [phaseParity_phase_mul,
          left_phase, right_phase]
        classical
        simp [generatorPhaseParityCombination,
          add_mul, Finset.sum_add_distrib]
  | inv pauli _ exists_coefficients =>
      rcases exists_coefficients with
        ⟨coefficients, row_equal, phase_equal⟩
      refine ⟨coefficients, ?_, ?_⟩
      · rw [Pauli.projectiveRow_inv, row_equal]
      · rw [phaseParity_phase_inv, phase_equal]

/-! ## Pivot products and scalar relations -/

abbrev EchelonPivotIndex
    (generators : List (DensePauli m)) :=
  Fin
    (EchelonForm.new
      (bitMatrixFromPaulis generators)).pivots.length

def pivotPauliProduct
    (generators : List (DensePauli m))
    (index : EchelonPivotIndex generators) :
    Pauli m :=
  echelonPauliProduct generators
    ⟨index.val,
      index.isLt.trans_le
        (EchelonForm.new_pivots_length_le
          (bitMatrixFromPaulis generators))⟩

@[simp]
theorem pivotPauliProduct_projectiveRow
    (generators : List (DensePauli m))
    (index : EchelonPivotIndex generators) :
    (pivotPauliProduct generators index).projectiveRow =
      pivotRow
        (bitMatrixFromPaulis generators) index := by
  exact echelonPauliProduct_projectiveRow _ _

theorem pivotPauliProduct_projectiveRows_linearIndependent
    (generators : List (DensePauli m)) :
    LinearIndependent F2 fun
      index : EchelonPivotIndex generators =>
        (pivotPauliProduct generators index).projectiveRow := by
  have completion_independent :=
    rrefCompletionFamily_linearIndependent
      (bitMatrixFromPaulis generators)
  have pivot_independent :=
    completion_independent.comp
      (fun index => Sum.inl index)
      Sum.inl_injective
  simpa only [pivotPauliProduct_projectiveRow]

abbrev EchelonRelationIndex
    (generators : List (DensePauli m)) :=
  {row : Fin generators.length //
    (EchelonForm.new
      (bitMatrixFromPaulis generators)).pivots.length ≤
        row.val}

def relationPauliProduct
    (generators : List (DensePauli m))
    (row : EchelonRelationIndex generators) :
    Pauli m :=
  echelonPauliProduct generators row.1

@[simp]
theorem relationPauliProduct_projectiveRow
    (generators : List (DensePauli m))
    (row : EchelonRelationIndex generators) :
    (relationPauliProduct generators row).projectiveRow =
      0 := by
  rw [relationPauliProduct,
    echelonPauliProduct_projectiveRow]
  funext column
  rw [PackedMatrix.decode_get]
  rw [(EchelonForm.new_isRREF
    (bitMatrixFromPaulis generators)).rows_zero
      row.1 row.2 column.val column.isLt]
  rfl

theorem relationPauliProduct_projective
    (generators : List (DensePauli m))
    (row : EchelonRelationIndex generators) :
    (relationPauliProduct generators row).projective =
      0 := by
  have projective_eq_one :=
    Pauli.projective_eq_of_projectiveRow_eq
      (left := relationPauliProduct generators row)
      (right := 1)
      (by
        rw [relationPauliProduct_projectiveRow,
          Pauli.projectiveRow_one])
  exact projective_eq_one

theorem echelonPauliProduct_eq_pivotPauliProduct
    (generators : List (DensePauli m))
    (row : Fin generators.length)
    (is_pivot :
      row.val <
        (EchelonForm.new
          (bitMatrixFromPaulis generators)).pivots.length) :
    echelonPauliProduct generators row =
      pivotPauliProduct generators
        ⟨row.val, is_pivot⟩ := by
  rfl

theorem echelonPauliProduct_eq_relationPauliProduct
    (generators : List (DensePauli m))
    (row : Fin generators.length)
    (is_relation :
      (EchelonForm.new
        (bitMatrixFromPaulis generators)).pivots.length ≤
          row.val) :
    echelonPauliProduct generators row =
      relationPauliProduct generators
        ⟨row, is_relation⟩ := by
  rfl

theorem relationPauliProduct_eq_one
    (generators : List (DensePauli m))
    (row : EchelonRelationIndex generators)
    (phase_zero :
      (relationPauliProduct generators row).phase = 0) :
    relationPauliProduct generators row = 1 := by
  rw [Pauli.eq_scalar_phase_of_projective_eq_zero
      (relationPauliProduct generators row)
      (relationPauliProduct_projective
        generators row),
    phase_zero, Pauli.scalar_zero]

theorem Pauli.commute_of_projective_eq_zero
    {scalar pauli : Pauli m}
    (projective_zero : scalar.projective = 0) :
    Commute scalar pauli := by
  apply
    (Pauli.commute_iff_commutationPairing_eq_zero
      scalar pauli).mpr
  rw [projective_zero]
  simp [ProjectivePauli.commutationPairing]

theorem echelonPauliProducts_commute
    (generators : List (DensePauli m))
    (pivots_commute :
      ∀ left right : EchelonPivotIndex generators,
        Commute
          (pivotPauliProduct generators left)
          (pivotPauliProduct generators right))
    (left right : Fin generators.length) :
    Commute
      (echelonPauliProduct generators left)
      (echelonPauliProduct generators right) := by
  by_cases left_is_pivot :
      left.val <
        (EchelonForm.new
          (bitMatrixFromPaulis generators)).pivots.length
  · by_cases right_is_pivot :
        right.val <
          (EchelonForm.new
            (bitMatrixFromPaulis generators)).pivots.length
    · rw [echelonPauliProduct_eq_pivotPauliProduct
          generators left left_is_pivot,
        echelonPauliProduct_eq_pivotPauliProduct
          generators right right_is_pivot]
      exact
        pivots_commute
          ⟨left.val, left_is_pivot⟩
          ⟨right.val, right_is_pivot⟩
    · rw [echelonPauliProduct_eq_pivotPauliProduct
          generators left left_is_pivot,
        echelonPauliProduct_eq_relationPauliProduct
          generators right
          (Nat.le_of_not_gt right_is_pivot)]
      exact
        (Pauli.commute_of_projective_eq_zero
          (relationPauliProduct_projective
            generators
            ⟨right, Nat.le_of_not_gt right_is_pivot⟩)).symm
  · by_cases right_is_pivot :
        right.val <
          (EchelonForm.new
            (bitMatrixFromPaulis generators)).pivots.length
    · rw [echelonPauliProduct_eq_relationPauliProduct
          generators left
          (Nat.le_of_not_gt left_is_pivot),
        echelonPauliProduct_eq_pivotPauliProduct
          generators right right_is_pivot]
      exact
        Pauli.commute_of_projective_eq_zero
          (relationPauliProduct_projective
            generators
            ⟨left, Nat.le_of_not_gt left_is_pivot⟩)
    · rw [echelonPauliProduct_eq_relationPauliProduct
          generators left
          (Nat.le_of_not_gt left_is_pivot),
        echelonPauliProduct_eq_relationPauliProduct
          generators right
          (Nat.le_of_not_gt right_is_pivot)]
      exact
        Pauli.commute_of_projective_eq_zero
          (relationPauliProduct_projective
            generators
            ⟨left, Nat.le_of_not_gt left_is_pivot⟩)

theorem echelonPauliGroup_isMulCommutative
    (generators : List (DensePauli m))
    (pivots_commute :
      ∀ left right : EchelonPivotIndex generators,
        Commute
          (pivotPauliProduct generators left)
          (pivotPauliProduct generators right)) :
    IsMulCommutative (echelonPauliGroup generators) := by
  apply Subgroup.isMulCommutative_closure
  rintro _ ⟨left, rfl⟩ _ ⟨right, rfl⟩ _
  exact
    echelonPauliProducts_commute
      generators pivots_commute left right

theorem generatedPauliGroup_isMulCommutative
    (generators : List (DensePauli m))
    (pivots_commute :
      ∀ left right : EchelonPivotIndex generators,
        Commute
          (pivotPauliProduct generators left)
          (pivotPauliProduct generators right)) :
    IsMulCommutative (generatedPauliGroup generators) := by
  have echelon_commutative :
      IsMulCommutative
        (echelonPauliGroup generators) :=
    echelonPauliGroup_isMulCommutative
      generators pivots_commute
  apply Subgroup.isMulCommutative_closure
  rintro _ ⟨left_index, rfl⟩
    _ ⟨right_index, rfl⟩ _
  rcases
      exists_mem_echelonPauliGroup_same_projectiveRow
        generators
        (DensePauli.decode_mem_generatedPauliGroup
          generators left_index) with
    ⟨left, left_mem, left_row⟩
  rcases
      exists_mem_echelonPauliGroup_same_projectiveRow
        generators
        (DensePauli.decode_mem_generatedPauliGroup
          generators right_index) with
    ⟨right, right_mem, right_row⟩
  have transformed_commute :
      Commute left right :=
    isMulCommutative_iff_of_setLike.mp
      echelon_commutative
      left left_mem right right_mem
  have transformed_pairing_zero :=
    (Pauli.commute_iff_commutationPairing_eq_zero
      left right).mp transformed_commute
  have left_projective :
      left.projective =
        generators[left_index].decode.projective :=
    Pauli.projective_eq_of_projectiveRow_eq left_row
  have right_projective :
      right.projective =
        generators[right_index].decode.projective :=
    Pauli.projective_eq_of_projectiveRow_eq right_row
  apply
    (Pauli.commute_iff_commutationPairing_eq_zero
      generators[left_index].decode
      generators[right_index].decode).mpr
  rw [← left_projective, ← right_projective]
  exact transformed_pairing_zero

theorem echelonPauliProduct_isOrderTwo
    (generators : List (DensePauli m))
    (pivot_order_two :
      ∀ index : EchelonPivotIndex generators,
        Pauli.IsOrderTwo
          (pivotPauliProduct generators index))
    (relation_phase_zero :
      ∀ row : EchelonRelationIndex generators,
        (relationPauliProduct generators row).phase =
          0)
    (row : Fin generators.length) :
    Pauli.IsOrderTwo
      (echelonPauliProduct generators row) := by
  by_cases is_pivot :
      row.val <
        (EchelonForm.new
          (bitMatrixFromPaulis generators)).pivots.length
  · rw [echelonPauliProduct_eq_pivotPauliProduct
        generators row is_pivot]
    exact pivot_order_two ⟨row.val, is_pivot⟩
  · let relation :
        EchelonRelationIndex generators :=
      ⟨row, Nat.le_of_not_gt is_pivot⟩
    rw [echelonPauliProduct_eq_relationPauliProduct
        generators row relation.2,
      relationPauliProduct_eq_one
        generators relation
        (relation_phase_zero relation)]
    change (1 : Pauli m) * 1 = 1
    simp

theorem echelonPauliGroup_isOrderTwo
    (generators : List (DensePauli m))
    (pivots_commute :
      ∀ left right : EchelonPivotIndex generators,
        Commute
          (pivotPauliProduct generators left)
          (pivotPauliProduct generators right))
    (pivot_order_two :
      ∀ index : EchelonPivotIndex generators,
        Pauli.IsOrderTwo
          (pivotPauliProduct generators index))
    (relation_phase_zero :
      ∀ row : EchelonRelationIndex generators,
        (relationPauliProduct generators row).phase =
          0)
    {pauli : Pauli m}
    (member : pauli ∈ echelonPauliGroup generators) :
    Pauli.IsOrderTwo pauli := by
  have commutative :
      IsMulCommutative
        (echelonPauliGroup generators) :=
    echelonPauliGroup_isMulCommutative
      generators pivots_commute
  induction member using Subgroup.closure_induction with
  | mem pauli pauli_mem =>
      rcases pauli_mem with ⟨row, rfl⟩
      exact
        echelonPauliProduct_isOrderTwo
          generators pivot_order_two
          relation_phase_zero row
  | one =>
      change (1 : Pauli m) * 1 = 1
      simp
  | mul left right left_mem right_mem
        left_order_two right_order_two =>
      have commute :
          left * right = right * left :=
        isMulCommutative_iff_of_setLike.mp
          commutative
          left left_mem right right_mem
      change (left * right) * (left * right) = 1
      calc
        (left * right) * (left * right) =
            left * (right * left) * right := by
              simp only [mul_assoc]
        _ = left * (left * right) * right := by
              rw [commute]
        _ = (left * left) * (right * right) := by
              simp only [mul_assoc]
        _ = 1 := by
          rw [left_order_two, right_order_two,
            one_mul]
  | inv pauli _ order_two =>
      have inverse_eq :
          pauli⁻¹ = pauli :=
        (Pauli.isHermitian_iff_isOrderTwo pauli).mpr
          order_two
      rw [inverse_eq]
      exact order_two

/-- Scalar phases read from the zero rows of the transformed matrix. -/
def relationScalarPhases
    (generators : List (DensePauli m)) :
    AddSubgroup PauliPhase :=
  AddSubgroup.closure
    (Set.range fun
      row : EchelonRelationIndex generators =>
        (relationPauliProduct generators row).phase)

theorem relationScalarPhases_le_scalarPhases
    (generators : List (DensePauli m)) :
    relationScalarPhases generators ≤
      scalarPhases
        (generatedPauliGroup generators) := by
  rw [relationScalarPhases,
    AddSubgroup.closure_le]
  rintro _ ⟨row, rfl⟩
  change
    Pauli.scalar (m := m)
        (relationPauliProduct generators row).phase ∈
      generatedPauliGroup generators
  rw [← Pauli.eq_scalar_phase_of_projective_eq_zero
    (relationPauliProduct generators row)
    (relationPauliProduct_projective
      generators row)]
  exact
    echelonPauliProduct_mem_generatedPauliGroup
      generators row.1

def transformCoordinates
    (generators : List (DensePauli m))
    (coefficients : Fin generators.length → F2) :
    Fin generators.length → F2 :=
  Matrix.vecMul coefficients
    (EchelonForm.new
      (bitMatrixFromPaulis generators)).transformInvT.decode.transpose

theorem transformCoordinates_vecMul_transform
    (generators : List (DensePauli m))
    (coefficients : Fin generators.length → F2) :
    Matrix.vecMul
        (transformCoordinates generators coefficients)
        (EchelonForm.new
          (bitMatrixFromPaulis generators)).transform.decode =
      coefficients := by
  rw [transformCoordinates,
    Matrix.vecMul_vecMul]
  have inverse :=
    mul_eq_one_comm.mp
      (EchelonForm.new_transform_mul_inv
        (bitMatrixFromPaulis generators))
  rw [inverse, Matrix.vecMul_one]

theorem transformedGeneratorPhaseParity
    (generators : List (DensePauli m))
    (row : Fin generators.length) :
    Matrix.mulVec
        (EchelonForm.new
          (bitMatrixFromPaulis generators)).transform.decode
        (fun index =>
          phaseParity generators[index].decode.phase)
        row =
      phaseParity
        (echelonPauliProduct generators row).phase := by
  rw [echelonPauliProduct,
    selectedPauliProduct_phaseParity]
  rfl

theorem rrefPivotCoefficient_eq_zero
    (generators : List (DensePauli m))
    (coefficients : Fin generators.length → F2)
    (combination_zero :
      Matrix.vecMul coefficients
          (EchelonForm.new
            (bitMatrixFromPaulis generators)).matrix.decode =
        0)
    (pivot : EchelonPivotIndex generators) :
    coefficients
        ⟨pivot.val,
          pivot.isLt.trans_le
            (EchelonForm.new_pivots_length_le
              (bitMatrixFromPaulis generators))⟩ =
      0 := by
  let pivot_row : Fin generators.length :=
    ⟨pivot.val,
      pivot.isLt.trans_le
        (EchelonForm.new_pivots_length_le
          (bitMatrixFromPaulis generators))⟩
  have entry
      (row : Fin generators.length) :
      (EchelonForm.new
          (bitMatrixFromPaulis generators)).matrix.decode
            row
            (pivotColumn
              (bitMatrixFromPaulis generators) pivot) =
        if row = pivot_row then 1 else 0 := by
    by_cases equal : row = pivot_row
    · rw [ite_eq_left equal]
      subst row
      rw [PackedMatrix.decode_get]
      change
        Bool.toF2
            ((EchelonForm.new
              (bitMatrixFromPaulis generators)).matrix.get
                pivot_row
                ((EchelonForm.new
                  (bitMatrixFromPaulis generators)).pivots.get
                    pivot)) =
          1
      have pivot_set :=
        (EchelonForm.new_isRREF
          (bitMatrixFromPaulis generators)).pivot_unit
            pivot.val pivot.isLt pivot_row
      have pivot_value :
          (EchelonForm.new
              (bitMatrixFromPaulis generators)).matrix.get
                pivot_row
                ((EchelonForm.new
                  (bitMatrixFromPaulis generators)).pivots.get
                    pivot) =
            true := by
        simpa using pivot_set.mpr rfl
      rw [pivot_value]
      rfl
    · rw [ite_eq_right equal,
        PackedMatrix.decode_get]
      change
        Bool.toF2
            ((EchelonForm.new
              (bitMatrixFromPaulis generators)).matrix.get
                row
                ((EchelonForm.new
                  (bitMatrixFromPaulis generators)).pivots.get
                    pivot)) =
          0
      have value_not_equal :
          row.val ≠ pivot.val := by
        intro values_equal
        apply equal
        exact Fin.ext values_equal
      have pivot_not_set :
          (EchelonForm.new
              (bitMatrixFromPaulis generators)).matrix.get
                row
                ((EchelonForm.new
                  (bitMatrixFromPaulis generators)).pivots.get
                    pivot) ≠
            true := by
        intro pivot_set
        exact
          value_not_equal
            (((EchelonForm.new_isRREF
                (bitMatrixFromPaulis generators)).pivot_unit
                  pivot.val pivot.isLt row).mp
                    (by simpa using pivot_set))
      rw [Bool.eq_false_of_not_eq_true pivot_not_set]
      rfl
  have at_pivot :=
    congrFun combination_zero
      (pivotColumn
        (bitMatrixFromPaulis generators) pivot)
  simp only [Matrix.vecMul, dotProduct] at at_pivot
  simp_rw [entry] at at_pivot
  simpa [pivot_row] using at_pivot

theorem scalarPhaseParity_eq_zero_of_relations
    (generators : List (DensePauli m))
    (relations_even :
      ∀ row : EchelonRelationIndex generators,
        phaseParity
            (relationPauliProduct generators row).phase =
          0)
    {phase : PauliPhase}
    (member :
      Pauli.scalar (m := m) phase ∈
        generatedPauliGroup generators) :
    phaseParity phase = 0 := by
  rcases
      generatedPauliGroup_has_binary_combination
        generators member with
    ⟨coefficients, projective_equal, phase_equal⟩
  have scalar_projective_row_zero :
      (Pauli.scalar (m := m) phase).projectiveRow =
        0 := by
    funext column
    refine Fin.addCases ?_ ?_ column <;>
      intro index
    · rw [Pauli.projectiveRow_x]
      rfl
    · rw [Pauli.projectiveRow_z]
      rfl
  have original_combination_zero :
      Matrix.vecMul coefficients
          (bitMatrixFromPaulis generators).decode =
        0 := by
    rw [← generatorProjectiveCombination_eq_vecMul]
    rw [← projective_equal]
    exact scalar_projective_row_zero
  let transformed_coefficients :=
    transformCoordinates generators coefficients
  have reconstruct :
      Matrix.vecMul transformed_coefficients
          (EchelonForm.new
            (bitMatrixFromPaulis generators)).transform.decode =
        coefficients := by
    exact
      transformCoordinates_vecMul_transform
        generators coefficients
  have reduced_combination_zero :
      Matrix.vecMul transformed_coefficients
          (EchelonForm.new
            (bitMatrixFromPaulis generators)).matrix.decode =
        0 := by
    rw [← EchelonForm.new_transform_mul_eq,
      ← Matrix.vecMul_vecMul, reconstruct,
      original_combination_zero]
  have pivot_coefficient_zero
      (pivot : EchelonPivotIndex generators) :
      transformed_coefficients
          ⟨pivot.val,
            pivot.isLt.trans_le
              (EchelonForm.new_pivots_length_le
                (bitMatrixFromPaulis generators))⟩ =
        0 :=
    rrefPivotCoefficient_eq_zero
      generators transformed_coefficients
      reduced_combination_zero pivot
  have phase_combination_zero :
      generatorPhaseParityCombination
          generators coefficients =
        0 := by
    calc
      generatorPhaseParityCombination
          generators coefficients =
          dotProduct coefficients
            (fun index =>
              phaseParity
                generators[index].decode.phase) := rfl
      _ =
          dotProduct
            (Matrix.vecMul transformed_coefficients
              (EchelonForm.new
                (bitMatrixFromPaulis generators)).transform.decode)
            (fun index =>
              phaseParity
                generators[index].decode.phase) := by
              rw [reconstruct]
      _ =
          dotProduct transformed_coefficients
            (Matrix.mulVec
              (EchelonForm.new
                (bitMatrixFromPaulis generators)).transform.decode
              (fun index =>
                phaseParity
                  generators[index].decode.phase)) := by
              exact
                (Matrix.dotProduct_mulVec
                  transformed_coefficients
                  (EchelonForm.new
                    (bitMatrixFromPaulis generators)).transform.decode
                  (fun index =>
                    phaseParity
                      generators[index].decode.phase)).symm
      _ = 0 := by
        simp only [dotProduct]
        apply Finset.sum_eq_zero
        intro row _
        by_cases is_pivot :
            row.val <
              (EchelonForm.new
                (bitMatrixFromPaulis generators)).pivots.length
        · let pivot : EchelonPivotIndex generators :=
            ⟨row.val, is_pivot⟩
          have row_eq :
              row =
                ⟨pivot.val,
                  pivot.isLt.trans_le
                    (EchelonForm.new_pivots_length_le
                      (bitMatrixFromPaulis generators))⟩ :=
            Fin.ext rfl
          rw [row_eq,
            pivot_coefficient_zero pivot, zero_mul]
        · let relation :
              EchelonRelationIndex generators :=
            ⟨row, Nat.le_of_not_gt is_pivot⟩
          have transformed_phase_zero :
              Matrix.mulVec
                  (EchelonForm.new
                    (bitMatrixFromPaulis generators)).transform.decode
                  (fun index =>
                    phaseParity
                      generators[index].decode.phase)
                  row =
                0 := by
            rw [transformedGeneratorPhaseParity]
            simpa [relation, relationPauliProduct] using
              relations_even relation
          rw [transformed_phase_zero, mul_zero]
  change phaseParity phase =
      generatorPhaseParityCombination
        generators coefficients at phase_equal
  rw [phase_equal, phase_combination_zero]

theorem phaseParity_eq_one_iff
    (phase : PauliPhase) :
    phaseParity phase = 1 ↔
      phase = 1 ∨ phase = 3 := by
  rcases
      pauliPhase_eq_zero_or_one_or_two_or_three
        phase with
    phase_zero | phase_one | phase_two | phase_three
  · subst phase
    rw [phaseParity_zero]
    constructor
    · intro impossible
      exact (zero_ne_one impossible).elim
    · rintro (impossible | impossible)
      · exact
          ((by decide :
            (0 : PauliPhase) ≠ 1)
            impossible).elim
      · exact
          ((by decide :
            (0 : PauliPhase) ≠ 3)
            impossible).elim
  · subst phase
    rw [phaseParity_one]
    exact ⟨fun _ => Or.inl rfl, fun _ => rfl⟩
  · subst phase
    rw [phaseParity_two]
    constructor
    · intro impossible
      exact (zero_ne_one impossible).elim
    · rintro (impossible | impossible)
      · exact
          ((by decide :
            (2 : PauliPhase) ≠ 1)
            impossible).elim
      · exact
          ((by decide :
            (2 : PauliPhase) ≠ 3)
            impossible).elim
  · subst phase
    rw [phaseParity_three]
    exact ⟨fun _ => Or.inr rfl, fun _ => rfl⟩

theorem phaseParity_eq_zero_iff
    (phase : PauliPhase) :
    phaseParity phase = 0 ↔
      phase = 0 ∨ phase = 2 := by
  rcases
      pauliPhase_eq_zero_or_one_or_two_or_three
        phase with
    phase_zero | phase_one | phase_two | phase_three
  · subst phase
    rw [phaseParity_zero]
    exact ⟨fun _ => Or.inl rfl, fun _ => rfl⟩
  · subst phase
    rw [phaseParity_one]
    constructor
    · intro impossible
      exact (one_ne_zero impossible).elim
    · rintro (impossible | impossible)
      · exact
          ((by decide :
            (1 : PauliPhase) ≠ 0)
            impossible).elim
      · exact
          ((by decide :
            (1 : PauliPhase) ≠ 2)
            impossible).elim
  · subst phase
    rw [phaseParity_two]
    exact ⟨fun _ => Or.inr rfl, fun _ => rfl⟩
  · subst phase
    rw [phaseParity_three]
    constructor
    · intro impossible
      exact (one_ne_zero impossible).elim
    · rintro (impossible | impossible)
      · exact
          ((by decide :
            (3 : PauliPhase) ≠ 0)
            impossible).elim
      · exact
          ((by decide :
            (3 : PauliPhase) ≠ 2)
            impossible).elim

theorem one_mem_scalarPhases_iff_exists_odd_relation
    (generators : List (DensePauli m)) :
    (1 : PauliPhase) ∈
        scalarPhases
          (generatedPauliGroup generators) ↔
      ∃ row : EchelonRelationIndex generators,
        phaseParity
            (relationPauliProduct generators row).phase =
          1 := by
  constructor
  · intro one_mem
    by_contra no_odd_relation
    have relations_even :
        ∀ row : EchelonRelationIndex generators,
          phaseParity
              (relationPauliProduct generators row).phase =
            0 := by
      intro row
      rcases Pauli.f2_eq_zero_or_one
          (phaseParity
            (relationPauliProduct generators row).phase) with
        zero | one
      · exact zero
      · exact
          (no_odd_relation ⟨row, one⟩).elim
    have parity_zero :=
      scalarPhaseParity_eq_zero_of_relations
        generators relations_even one_mem
    have parity_one :
        phaseParity (1 : PauliPhase) = 1 := by
      exact phaseParity_one
    rw [parity_one] at parity_zero
    exact one_ne_zero parity_zero
  · rintro ⟨row, odd_phase⟩
    change
      Pauli.scalar (m := m) 1 ∈
        generatedPauliGroup generators
    let relation :=
      relationPauliProduct generators row
    have relation_mem :
        relation ∈
          generatedPauliGroup generators :=
      echelonPauliProduct_mem_generatedPauliGroup
        generators row.1
    have relation_scalar :
        relation =
          Pauli.scalar relation.phase :=
      Pauli.eq_scalar_phase_of_projective_eq_zero
        relation
        (relationPauliProduct_projective
          generators row)
    have scalar_phase_mem :
        Pauli.scalar (m := m) relation.phase ∈
          generatedPauliGroup generators := by
      rw [← relation_scalar]
      exact relation_mem
    rcases
        (phaseParity_eq_one_iff relation.phase).mp
          odd_phase with
      phase_one | phase_three
    · rw [phase_one] at scalar_phase_mem
      exact scalar_phase_mem
    · rw [phase_three] at scalar_phase_mem
      have inverse_mem :=
        (generatedPauliGroup generators).inv_mem
          scalar_phase_mem
      rw [← Pauli.scalar_neg] at inverse_mem
      have neg_three :
          (-(3 : PauliPhase)) = 1 := by
        decide
      rw [neg_three] at inverse_mem
      exact inverse_mem

theorem decodedGenerator_isOrderTwo_of_standard_data
    (generators : List (DensePauli m))
    (pivots_commute :
      ∀ left right : EchelonPivotIndex generators,
        Commute
          (pivotPauliProduct generators left)
          (pivotPauliProduct generators right))
    (pivot_order_two :
      ∀ pivot : EchelonPivotIndex generators,
        Pauli.IsOrderTwo
          (pivotPauliProduct generators pivot))
    (relation_phase_zero :
      ∀ row : EchelonRelationIndex generators,
        (relationPauliProduct generators row).phase =
          0)
    (index : Fin generators.length) :
    Pauli.IsOrderTwo generators[index].decode := by
  have generator_mem :=
    DensePauli.decode_mem_generatedPauliGroup
      generators index
  rcases
      exists_mem_echelonPauliGroup_same_projectiveRow
        generators generator_mem with
    ⟨transformed, transformed_mem, rows_equal⟩
  have transformed_order_two :
      Pauli.IsOrderTwo transformed :=
    echelonPauliGroup_isOrderTwo
      generators pivots_commute pivot_order_two
      relation_phase_zero transformed_mem
  have projective_equal :
      transformed.projective =
        generators[index].decode.projective :=
    Pauli.projective_eq_of_projectiveRow_eq
      rows_equal
  let correction :=
    generators[index].decode * transformed⁻¹
  have correction_mem :
      correction ∈
        generatedPauliGroup generators := by
    apply (generatedPauliGroup generators).mul_mem
    · exact generator_mem
    · exact
        (generatedPauliGroup generators).inv_mem
          (echelonPauliGroup_le_generatedPauliGroup
            generators transformed_mem)
  have correction_projective_zero :
      correction.projective = 0 := by
    change
      (generators[index].decode *
          transformed⁻¹).projective =
        0
    rw [Pauli.projective_mul,
      Pauli.projective_inv, projective_equal,
      ProjectivePauli.add_self_eq_zero]
  have correction_scalar :
      correction =
        Pauli.scalar correction.phase :=
    Pauli.eq_scalar_phase_of_projective_eq_zero
      correction correction_projective_zero
  have scalar_correction_mem :
      Pauli.scalar (m := m) correction.phase ∈
        generatedPauliGroup generators := by
    rw [← correction_scalar]
    exact correction_mem
  have relations_even :
      ∀ row : EchelonRelationIndex generators,
        phaseParity
            (relationPauliProduct generators row).phase =
          0 := by
    intro row
    rw [relation_phase_zero row, phaseParity_zero]
  have correction_phase_even :
      phaseParity correction.phase = 0 :=
    scalarPhaseParity_eq_zero_of_relations
      generators relations_even
      scalar_correction_mem
  have generator_eq :
      generators[index].decode =
        Pauli.scalar correction.phase * transformed := by
    rw [← correction_scalar]
    simp [correction, mul_assoc]
  rcases
      (phaseParity_eq_zero_iff
        correction.phase).mp correction_phase_even with
    phase_zero | phase_two
  · rw [phase_zero, Pauli.scalar_zero,
      one_mul] at generator_eq
    rw [generator_eq]
    exact transformed_order_two
  · rw [phase_two, Pauli.scalar_two_mul] at generator_eq
    rw [generator_eq]
    simpa [Pauli.IsOrderTwo] using
      transformed_order_two

theorem generatedPauliGroup_isOrderTwo
    (generators : List (DensePauli m))
    (pivots_commute :
      ∀ left right : EchelonPivotIndex generators,
        Commute
          (pivotPauliProduct generators left)
          (pivotPauliProduct generators right))
    (pivot_order_two :
      ∀ pivot : EchelonPivotIndex generators,
        Pauli.IsOrderTwo
          (pivotPauliProduct generators pivot))
    (relation_phase_zero :
      ∀ row : EchelonRelationIndex generators,
        (relationPauliProduct generators row).phase =
          0)
    {pauli : Pauli m}
    (member :
      pauli ∈ generatedPauliGroup generators) :
    Pauli.IsOrderTwo pauli := by
  have commutative :
      IsMulCommutative
        (generatedPauliGroup generators) :=
    generatedPauliGroup_isMulCommutative
      generators pivots_commute
  induction member using Subgroup.closure_induction with
  | mem pauli pauli_mem =>
      rcases pauli_mem with ⟨index, rfl⟩
      exact
        decodedGenerator_isOrderTwo_of_standard_data
          generators pivots_commute pivot_order_two
          relation_phase_zero index
  | one =>
      change (1 : Pauli m) * 1 = 1
      simp
  | mul left right left_mem right_mem
        left_order_two right_order_two =>
      have commute :
          left * right = right * left :=
        isMulCommutative_iff_of_setLike.mp
          commutative
          left left_mem right right_mem
      change (left * right) * (left * right) = 1
      calc
        (left * right) * (left * right) =
            left * (right * left) * right := by
              simp only [mul_assoc]
        _ = left * (left * right) * right := by
              rw [commute]
        _ = (left * left) * (right * right) := by
              simp only [mul_assoc]
        _ = 1 := by
          rw [left_order_two, right_order_two,
            one_mul]
  | inv pauli _ order_two =>
      have inverse_eq :
          pauli⁻¹ = pauli :=
        (Pauli.isHermitian_iff_isOrderTwo pauli).mpr
          order_two
      rw [inverse_eq]
      exact order_two

set_option linter.style.haveILetI false in
open scoped IsMulCommutative in
theorem selectedPauliProduct_mul_of_standard_data
    (generators : List (DensePauli m))
    (pivots_commute :
      ∀ left right : EchelonPivotIndex generators,
        Commute
          (pivotPauliProduct generators left)
          (pivotPauliProduct generators right))
    (pivot_order_two :
      ∀ pivot : EchelonPivotIndex generators,
        Pauli.IsOrderTwo
          (pivotPauliProduct generators pivot))
    (relation_phase_zero :
      ∀ row : EchelonRelationIndex generators,
        (relationPauliProduct generators row).phase =
          0)
    (left right : Fin generators.length → F2) :
    selectedPauliProduct generators left *
        selectedPauliProduct generators right =
      selectedPauliProduct generators (left + right) := by
  let group := generatedPauliGroup generators
  let commutative : IsMulCommutative group :=
    generatedPauliGroup_isMulCommutative
      generators pivots_commute
  letI : CommGroup group :=
    { (inferInstance : Group group) with
      mul_comm := fun left right =>
        Subtype.ext
          (isMulCommutative_iff_of_setLike.mp
            commutative
            left.1 left.2 right.1 right.2) }
  let generator (index : Fin generators.length) : group :=
    ⟨generators[index].decode,
      DensePauli.decode_mem_generatedPauliGroup
        generators index⟩
  let product
      (coefficients : Fin generators.length → F2) :
      group :=
    ∏ index,
      if coefficients index = 0 then
        1
      else
        generator index
  have product_coe
      (coefficients : Fin generators.length → F2) :
      (product coefficients : Pauli m) =
        selectedPauliProduct
          generators coefficients := by
    change
      ((∏ index,
          if coefficients index = 0 then
            (1 : group)
          else
            generator index : group) :
        Pauli m) =
          selectedPauliProduct generators coefficients
    rw [← Fin.prod_ofFn]
    change
      (Subgroup.subtype group)
          ((List.ofFn fun index =>
            if coefficients index = 0 then
              (1 : group)
            else
              generator index).prod) =
        (List.ofFn fun index =>
          if coefficients index = 0 then
            (1 : Pauli m)
          else
            generators[index].decode).prod
    rw [map_list_prod, List.map_ofFn]
    congr 1
    apply congrArg List.ofFn
    funext index
    by_cases zero : coefficients index = 0
    · simp [zero]
    · simp [zero, generator]
  have factor_mul
      (index : Fin generators.length) :
      (if left index = 0 then
          (1 : group)
        else
          generator index) *
          (if right index = 0 then
            1
          else
            generator index) =
        if (left + right) index = 0 then
          1
        else
          generator index := by
    change
      (if left index = 0 then
          (1 : group)
        else
          generator index) *
          (if right index = 0 then
            1
          else
            generator index) =
        if left index + right index = 0 then
          1
        else
          generator index
    rcases Pauli.f2_eq_zero_or_one
        (left index) with
      left_zero | left_one <;>
      rcases Pauli.f2_eq_zero_or_one
        (right index) with
      right_zero | right_one
    · rw [left_zero, right_zero]
      simp
    · rw [left_zero, right_one]
      simp
    · rw [left_one, right_zero]
      simp
    · rw [left_one, right_one]
      have square :
          generator index * generator index = 1 := by
        apply Subtype.ext
        exact
          decodedGenerator_isOrderTwo_of_standard_data
            generators pivots_commute pivot_order_two
            relation_phase_zero index
      simpa using square
  have products_mul :
      product left * product right =
        product (left + right) := by
    change
      (∏ index,
          if left index = 0 then
            (1 : group)
          else
            generator index) *
          (∏ index,
            if right index = 0 then
              1
            else
              generator index) =
        ∏ index,
          if (left + right) index = 0 then
            1
          else
            generator index
    rw [← Finset.prod_mul_distrib]
    apply Finset.prod_congr rfl
    intro index _
    exact factor_mul index
  calc
    selectedPauliProduct generators left *
        selectedPauliProduct generators right =
        (product left : Pauli m) *
          (product right : Pauli m) := by
            rw [product_coe left, product_coe right]
    _ = (product left * product right : group) := rfl
    _ = product (left + right) := by
          rw [products_mul]
    _ = selectedPauliProduct
          generators (left + right) :=
      product_coe (left + right)

theorem generatedPauliGroup_exists_selectedPauliProduct
    (generators : List (DensePauli m))
    (pivots_commute :
      ∀ left right : EchelonPivotIndex generators,
        Commute
          (pivotPauliProduct generators left)
          (pivotPauliProduct generators right))
    (pivot_order_two :
      ∀ pivot : EchelonPivotIndex generators,
        Pauli.IsOrderTwo
          (pivotPauliProduct generators pivot))
    (relation_phase_zero :
      ∀ row : EchelonRelationIndex generators,
        (relationPauliProduct generators row).phase =
          0)
    {pauli : Pauli m}
    (member :
      pauli ∈ generatedPauliGroup generators) :
    ∃ coefficients : Fin generators.length → F2,
      pauli =
        selectedPauliProduct generators coefficients := by
  induction member using Subgroup.closure_induction with
  | mem pauli pauli_mem =>
      rcases pauli_mem with ⟨index, rfl⟩
      exact
        ⟨Pi.single index 1,
          (selectedPauliProduct_single
            generators index).symm⟩
  | one =>
      exact
        ⟨0, (selectedPauliProduct_zero
          generators).symm⟩
  | mul left right _ _ left_exists right_exists =>
      rcases left_exists with
        ⟨left_coefficients, left_equal⟩
      rcases right_exists with
        ⟨right_coefficients, right_equal⟩
      refine
        ⟨left_coefficients + right_coefficients,
          ?_⟩
      rw [left_equal, right_equal,
        selectedPauliProduct_mul_of_standard_data
          generators pivots_commute pivot_order_two
          relation_phase_zero]
  | inv pauli pauli_mem exists_coefficients =>
      rcases exists_coefficients with
        ⟨coefficients, equal⟩
      refine ⟨coefficients, ?_⟩
      have order_two :
          Pauli.IsOrderTwo pauli :=
        generatedPauliGroup_isOrderTwo
          generators pivots_commute pivot_order_two
          relation_phase_zero pauli_mem
      have inverse_equal :
          pauli⁻¹ = pauli :=
        (Pauli.isHermitian_iff_isOrderTwo pauli).mpr
          order_two
      rw [inverse_equal, equal]

theorem selectedPauliProduct_eq_one_of_projective_zero
    (generators : List (DensePauli m))
    (pivots_commute :
      ∀ left right : EchelonPivotIndex generators,
        Commute
          (pivotPauliProduct generators left)
          (pivotPauliProduct generators right))
    (pivot_order_two :
      ∀ pivot : EchelonPivotIndex generators,
        Pauli.IsOrderTwo
          (pivotPauliProduct generators pivot))
    (relation_phase_zero :
      ∀ row : EchelonRelationIndex generators,
        (relationPauliProduct generators row).phase =
          0)
    (coefficients : Fin generators.length → F2)
    (projective_zero :
      generatorProjectiveCombination
          generators coefficients =
        0) :
    selectedPauliProduct generators coefficients = 1 := by
  have original_combination_zero :
      Matrix.vecMul coefficients
          (bitMatrixFromPaulis generators).decode =
        0 := by
    rw [← generatorProjectiveCombination_eq_vecMul]
    exact projective_zero
  let transformed_coefficients :=
    transformCoordinates generators coefficients
  have reconstruct :
      Matrix.vecMul transformed_coefficients
          (EchelonForm.new
            (bitMatrixFromPaulis generators)).transform.decode =
        coefficients :=
    transformCoordinates_vecMul_transform
      generators coefficients
  have reduced_combination_zero :
      Matrix.vecMul transformed_coefficients
          (EchelonForm.new
            (bitMatrixFromPaulis generators)).matrix.decode =
        0 := by
    rw [← EchelonForm.new_transform_mul_eq,
      ← Matrix.vecMul_vecMul, reconstruct,
      original_combination_zero]
  have pivot_coefficient_zero
      (pivot : EchelonPivotIndex generators) :
      transformed_coefficients
          ⟨pivot.val,
            pivot.isLt.trans_le
              (EchelonForm.new_pivots_length_le
                (bitMatrixFromPaulis generators))⟩ =
        0 :=
    rrefPivotCoefficient_eq_zero
      generators transformed_coefficients
      reduced_combination_zero pivot
  have coefficients_eq_sum :
      coefficients =
        ∑ row,
          transformed_coefficients row •
            (EchelonForm.new
              (bitMatrixFromPaulis generators)).transform.decode
                row := by
    rw [← reconstruct]
    funext column
    simp [Matrix.vecMul, dotProduct,
      Finset.sum_apply, Pi.smul_apply,
      smul_eq_mul]
  have selected_term_eq_one
      (row : Fin generators.length) :
      selectedPauliProduct generators
          (transformed_coefficients row •
            (EchelonForm.new
              (bitMatrixFromPaulis generators)).transform.decode
                row) =
        1 := by
    by_cases is_pivot :
        row.val <
          (EchelonForm.new
            (bitMatrixFromPaulis generators)).pivots.length
    · let pivot : EchelonPivotIndex generators :=
        ⟨row.val, is_pivot⟩
      have row_eq :
          row =
            ⟨pivot.val,
              pivot.isLt.trans_le
                (EchelonForm.new_pivots_length_le
                  (bitMatrixFromPaulis generators))⟩ :=
        Fin.ext rfl
      rw [row_eq,
        pivot_coefficient_zero pivot,
        zero_smul,
        selectedPauliProduct_zero]
    · let relation :
          EchelonRelationIndex generators :=
        ⟨row, Nat.le_of_not_gt is_pivot⟩
      rcases Pauli.f2_eq_zero_or_one
          (transformed_coefficients row) with
        zero | one
      · rw [zero, zero_smul,
          selectedPauliProduct_zero]
      · rw [one, one_smul]
        change
          echelonPauliProduct generators row = 1
        rw [echelonPauliProduct_eq_relationPauliProduct
            generators row relation.2,
          relationPauliProduct_eq_one
            generators relation
            (relation_phase_zero relation)]
  have selected_sum_eq_one
      (rows : Finset (Fin generators.length)) :
      selectedPauliProduct generators
          (∑ row ∈ rows,
            transformed_coefficients row •
              (EchelonForm.new
                (bitMatrixFromPaulis generators)).transform.decode
                  row) =
        1 := by
    induction rows using Finset.induction_on with
    | empty =>
        simp
    | @insert row rows not_mem induction =>
        rw [Finset.sum_insert not_mem,
          ← selectedPauliProduct_mul_of_standard_data
            generators pivots_commute pivot_order_two
            relation_phase_zero,
          selected_term_eq_one row, induction,
          one_mul]
  rw [coefficients_eq_sum]
  simpa using
    selected_sum_eq_one
      (Finset.univ : Finset
        (Fin generators.length))

theorem two_not_mem_scalarPhases_of_standard_data
    (generators : List (DensePauli m))
    (pivots_commute :
      ∀ left right : EchelonPivotIndex generators,
        Commute
          (pivotPauliProduct generators left)
          (pivotPauliProduct generators right))
    (pivot_order_two :
      ∀ pivot : EchelonPivotIndex generators,
        Pauli.IsOrderTwo
          (pivotPauliProduct generators pivot))
    (relation_phase_zero :
      ∀ row : EchelonRelationIndex generators,
        (relationPauliProduct generators row).phase =
          0) :
    (2 : PauliPhase) ∉
      scalarPhases
        (generatedPauliGroup generators) := by
  intro two_mem
  change
    Pauli.scalar (m := m) 2 ∈
      generatedPauliGroup generators at two_mem
  rcases
      generatedPauliGroup_exists_selectedPauliProduct
        generators pivots_commute pivot_order_two
        relation_phase_zero two_mem with
    ⟨coefficients, scalar_two_eq_selected⟩
  have projective_zero :
      generatorProjectiveCombination
          generators coefficients =
        0 := by
    rw [generatorProjectiveCombination_eq_vecMul,
      ← selectedPauliProduct_projectiveRow,
      ← scalar_two_eq_selected,
      Pauli.projectiveRow_scalar]
  have selected_eq_one :=
    selectedPauliProduct_eq_one_of_projective_zero
      generators pivots_commute pivot_order_two
      relation_phase_zero coefficients
      projective_zero
  have scalar_two_eq_one :
      Pauli.scalar (m := m) 2 = 1 := by
    rw [scalar_two_eq_selected, selected_eq_one]
  have phases_equal :=
    congrArg Pauli.phase scalar_two_eq_one
  rw [Pauli.phase_scalar, Pauli.phase_one] at phases_equal
  exact
    ((by decide :
      (2 : PauliPhase) ≠ 0)
      phases_equal)

theorem two_mem_scalarPhases_iff_standard_trigger
    (generators : List (DensePauli m)) :
    (2 : PauliPhase) ∈
        scalarPhases
          (generatedPauliGroup generators) ↔
      (∃ row : EchelonRelationIndex generators,
        (relationPauliProduct generators row).phase =
          2) ∨
      (∃ row : EchelonRelationIndex generators,
        phaseParity
            (relationPauliProduct generators row).phase =
          1) ∨
      (∃ pivot : EchelonPivotIndex generators,
        ¬Pauli.IsOrderTwo
          (pivotPauliProduct generators pivot)) ∨
      (∃ left right : EchelonPivotIndex generators,
        ¬Commute
          (pivotPauliProduct generators left)
          (pivotPauliProduct generators right)) := by
  constructor
  · intro two_mem
    by_contra no_trigger
    have no_relation_two :
        ¬∃ row : EchelonRelationIndex generators,
          (relationPauliProduct generators row).phase =
            2 := by
      intro exists_relation
      exact no_trigger (Or.inl exists_relation)
    have no_relation_odd :
        ¬∃ row : EchelonRelationIndex generators,
          phaseParity
              (relationPauliProduct generators row).phase =
            1 := by
      intro exists_relation
      exact
        no_trigger
          (Or.inr (Or.inl exists_relation))
    have pivot_order_two :
        ∀ pivot : EchelonPivotIndex generators,
          Pauli.IsOrderTwo
            (pivotPauliProduct generators pivot) := by
      intro pivot
      by_contra not_order_two
      exact
        no_trigger
          (Or.inr
            (Or.inr
              (Or.inl
                ⟨pivot, not_order_two⟩)))
    have pivots_commute :
        ∀ left right : EchelonPivotIndex generators,
          Commute
            (pivotPauliProduct generators left)
            (pivotPauliProduct generators right) := by
      intro left right
      by_contra not_commute
      exact
        no_trigger
          (Or.inr
            (Or.inr
              (Or.inr
                ⟨left, right, not_commute⟩)))
    have relation_phase_zero :
        ∀ row : EchelonRelationIndex generators,
          (relationPauliProduct generators row).phase =
            0 := by
      intro row
      have parity_zero :
          phaseParity
              (relationPauliProduct generators row).phase =
            0 := by
        rcases Pauli.f2_eq_zero_or_one
            (phaseParity
              (relationPauliProduct generators row).phase) with
          zero | one
        · exact zero
        · exact
            (no_relation_odd ⟨row, one⟩).elim
      rcases
          (phaseParity_eq_zero_iff
            (relationPauliProduct generators row).phase).mp
              parity_zero with
        phase_zero | phase_two
      · exact phase_zero
      · exact
          (no_relation_two
            ⟨row, phase_two⟩).elim
    exact
      (two_not_mem_scalarPhases_of_standard_data
        generators pivots_commute pivot_order_two
        relation_phase_zero) two_mem
  · intro trigger
    rcases trigger with
      relation_two |
        relation_odd |
        pivot_not_order_two |
        pivots_not_commute
    · rcases relation_two with ⟨row, phase_two⟩
      change
        Pauli.scalar (m := m) 2 ∈
          generatedPauliGroup generators
      have relation_mem :
          relationPauliProduct generators row ∈
            generatedPauliGroup generators :=
        echelonPauliProduct_mem_generatedPauliGroup
          generators row.1
      have scalar_phase_mem :
          Pauli.scalar (m := m)
              (relationPauliProduct generators row).phase ∈
            generatedPauliGroup generators := by
        rw [←
          Pauli.eq_scalar_phase_of_projective_eq_zero
            (relationPauliProduct generators row)
            (relationPauliProduct_projective
              generators row)]
        exact relation_mem
      rw [phase_two] at scalar_phase_mem
      exact scalar_phase_mem
    · rcases relation_odd with ⟨row, odd⟩
      have one_mem :
          (1 : PauliPhase) ∈
            scalarPhases
              (generatedPauliGroup generators) :=
        (one_mem_scalarPhases_iff_exists_odd_relation
          generators).mpr ⟨row, odd⟩
      have sum_mem :=
        (scalarPhases
          (generatedPauliGroup generators)).add_mem
            one_mem one_mem
      have one_add_one :
          (1 + 1 : PauliPhase) = 2 := by
        decide
      rw [one_add_one] at sum_mem
      exact sum_mem
    · rcases pivot_not_order_two with
        ⟨pivot, not_order_two⟩
      change
        Pauli.scalar (m := m) 2 ∈
          generatedPauliGroup generators
      have pivot_mem :
          pivotPauliProduct generators pivot ∈
            generatedPauliGroup generators := by
        exact
          echelonPauliProduct_mem_generatedPauliGroup
            generators
            ⟨pivot.val,
              pivot.isLt.trans_le
                (EchelonForm.new_pivots_length_le
                  (bitMatrixFromPaulis generators))⟩
      exact
        scalar_two_mem_of_not_isOrderTwo
          (generatedPauliGroup generators)
          pivot_mem not_order_two
    · rcases pivots_not_commute with
        ⟨left, right, not_commute⟩
      change
        Pauli.scalar (m := m) 2 ∈
          generatedPauliGroup generators
      have left_mem :
          pivotPauliProduct generators left ∈
            generatedPauliGroup generators := by
        exact
          echelonPauliProduct_mem_generatedPauliGroup
            generators
            ⟨left.val,
              left.isLt.trans_le
                (EchelonForm.new_pivots_length_le
                  (bitMatrixFromPaulis generators))⟩
      have right_mem :
          pivotPauliProduct generators right ∈
            generatedPauliGroup generators := by
        exact
          echelonPauliProduct_mem_generatedPauliGroup
            generators
            ⟨right.val,
              right.isLt.trans_le
                (EchelonForm.new_pivots_length_le
                  (bitMatrixFromPaulis generators))⟩
      have pairing_nonzero :
          ProjectivePauli.commutationPairing
              (pivotPauliProduct
                generators left).projective
              (pivotPauliProduct
                generators right).projective ≠
            0 := by
        intro pairing_zero
        apply not_commute
        exact
          (Pauli.commute_iff_commutationPairing_eq_zero
            (pivotPauliProduct generators left)
            (pivotPauliProduct generators right)).mpr
              pairing_zero
      have pairing_one :
          ProjectivePauli.commutationPairing
              (pivotPauliProduct
                generators left).projective
              (pivotPauliProduct
                generators right).projective =
            1 :=
        (Pauli.f2_eq_zero_or_one _).resolve_left
          pairing_nonzero
      exact
        scalar_two_mem_of_anticommutes
          (generatedPauliGroup generators)
          left_mem right_mem pairing_one

/-- A transformed zero row whose product has odd scalar phase. -/
def HasOddRelation
    (generators : List (DensePauli m)) : Prop :=
  ∃ row : EchelonRelationIndex generators,
    phaseParity
        (relationPauliProduct generators row).phase =
      1

/-- A transformed zero row whose product is `-I`. -/
def HasPhaseTwoRelation
    (generators : List (DensePauli m)) : Prop :=
  ∃ row : EchelonRelationIndex generators,
    (relationPauliProduct generators row).phase =
      2

/--
Pivot sources of `-I`: an order-four pivot product or an anticommuting pair.
-/
def HasPivotNegativeTrigger
    (generators : List (DensePauli m)) : Prop :=
  (∃ pivot : EchelonPivotIndex generators,
    ¬Pauli.IsOrderTwo
      (pivotPauliProduct generators pivot)) ∨
  (∃ left right : EchelonPivotIndex generators,
    ¬Commute
      (pivotPauliProduct generators left)
      (pivotPauliProduct generators right))

/--
Sources of `-I` after odd scalar relations have been ruled out: a `-I`
relation or a pivot source.
-/
def HasNegativeStandardTrigger
    (generators : List (DensePauli m)) : Prop :=
  HasPhaseTwoRelation generators ∨
    HasPivotNegativeTrigger generators

theorem one_mem_scalarPhases_iff_hasOddRelation
    (generators : List (DensePauli m)) :
    (1 : PauliPhase) ∈
        scalarPhases
          (generatedPauliGroup generators) ↔
      HasOddRelation generators := by
  simpa [HasOddRelation] using
    one_mem_scalarPhases_iff_exists_odd_relation
      generators

theorem two_mem_scalarPhases_iff_standard_classification
    (generators : List (DensePauli m)) :
    (2 : PauliPhase) ∈
        scalarPhases
          (generatedPauliGroup generators) ↔
      HasOddRelation generators ∨
        HasNegativeStandardTrigger generators := by
  rw [two_mem_scalarPhases_iff_standard_trigger]
  constructor
  · rintro
      (relation_two |
        relation_odd |
        pivot_not_order_two |
        pivots_not_commute)
    · exact
        Or.inr
          (Or.inl relation_two)
    · exact Or.inl relation_odd
    · exact
        Or.inr
          (Or.inr
            (Or.inl pivot_not_order_two))
    · exact
        Or.inr
          (Or.inr
            (Or.inr pivots_not_commute))
  · rintro
      (relation_odd |
        relation_two |
        pivot_not_order_two |
        pivots_not_commute)
    · exact
        Or.inr
          (Or.inl relation_odd)
    · exact Or.inl relation_two
    · exact
        Or.inr
          (Or.inr
            (Or.inl pivot_not_order_two))
    · exact
        Or.inr
          (Or.inr
            (Or.inr pivots_not_commute))

/--
Lean model of Rust's `phase_modulus_of`: odd zero-row relations select `1`,
otherwise a `-I` relation selects `2`, and no scalar relation selects `4`.
-/
noncomputable def relationPhaseModulus
    (generators : List (DensePauli m)) : ℕ := by
  classical
  exact
    if HasOddRelation generators then
      1
    else if HasPhaseTwoRelation generators then
      2
    else
      4

theorem relationPhaseModulus_eq_one_iff
    (generators : List (DensePauli m)) :
    relationPhaseModulus generators = 1 ↔
      HasOddRelation generators := by
  classical
  by_cases odd : HasOddRelation generators
  · simp [relationPhaseModulus, odd]
  · by_cases phase_two :
        HasPhaseTwoRelation generators
    · simp [relationPhaseModulus, odd, phase_two]
    · simp [relationPhaseModulus, odd, phase_two]

theorem relationPhaseModulus_eq_two_iff
    (generators : List (DensePauli m)) :
    relationPhaseModulus generators = 2 ↔
      ¬HasOddRelation generators ∧
        HasPhaseTwoRelation generators := by
  classical
  by_cases odd : HasOddRelation generators
  · simp [relationPhaseModulus, odd]
  · by_cases phase_two :
        HasPhaseTwoRelation generators
    · simp [relationPhaseModulus, odd, phase_two]
    · simp [relationPhaseModulus, odd, phase_two]

theorem relationPhaseModulus_eq_four_iff
    (generators : List (DensePauli m)) :
    relationPhaseModulus generators = 4 ↔
      ¬HasOddRelation generators ∧
        ¬HasPhaseTwoRelation generators := by
  classical
  by_cases odd : HasOddRelation generators
  · simp [relationPhaseModulus, odd]
  · by_cases phase_two :
        HasPhaseTwoRelation generators
    · simp [relationPhaseModulus, odd, phase_two]
    · simp [relationPhaseModulus, odd, phase_two]

/--
Rust-shaped result of `phases_generated_by`, computed from the verified
standard-form triggers. This corresponds to Rust when `is_abelian()` is
computed or its optional commutation promise is truthful.
-/
noncomputable def standardPhaseRepresentatives
    (generators : List (DensePauli m)) :
    List PauliPhase := by
  classical
  exact
    if HasOddRelation generators then
      [0, 1, 2, 3]
    else if HasNegativeStandardTrigger generators then
      [0, 2]
    else
      [0]

theorem standardPhaseRepresentatives_eq_phaseRepresentatives
    (generators : List (DensePauli m)) :
    standardPhaseRepresentatives generators =
      phaseRepresentatives
        (scalarPhases
          (generatedPauliGroup generators)) := by
  classical
  by_cases odd : HasOddRelation generators
  · have one_mem :
        (1 : PauliPhase) ∈
          scalarPhases
            (generatedPauliGroup generators) :=
      (one_mem_scalarPhases_iff_hasOddRelation
        generators).mpr odd
    simp [standardPhaseRepresentatives,
      phaseRepresentatives, odd, one_mem]
  · have one_not_mem :
        (1 : PauliPhase) ∉
          scalarPhases
            (generatedPauliGroup generators) := by
      intro one_mem
      exact
        odd
          ((one_mem_scalarPhases_iff_hasOddRelation
            generators).mp one_mem)
    by_cases negative :
        HasNegativeStandardTrigger generators
    · have two_mem :
          (2 : PauliPhase) ∈
            scalarPhases
              (generatedPauliGroup generators) :=
        (two_mem_scalarPhases_iff_standard_classification
          generators).mpr (Or.inr negative)
      simp [standardPhaseRepresentatives,
        phaseRepresentatives, odd, negative,
        one_not_mem, two_mem]
    · have two_not_mem :
          (2 : PauliPhase) ∉
            scalarPhases
              (generatedPauliGroup generators) := by
        intro two_mem
        rcases
            (two_mem_scalarPhases_iff_standard_classification
              generators).mp two_mem with
          odd_relation | negative_trigger
        · exact odd odd_relation
        · exact negative negative_trigger
      simp [standardPhaseRepresentatives,
        phaseRepresentatives, odd, negative,
        one_not_mem, two_not_mem]

/-- Number of independent scalar phase bits selected by standardization. -/
noncomputable def standardScalarPhaseRank
    (generators : List (DensePauli m)) : ℕ := by
  classical
  exact
    if HasOddRelation generators then
      2
    else if HasNegativeStandardTrigger generators then
      1
    else
      0

theorem standardScalarPhaseRank_eq_scalarPhaseRank
    (generators : List (DensePauli m)) :
    standardScalarPhaseRank generators =
      scalarPhaseRank
        (scalarPhases
          (generatedPauliGroup generators)) := by
  classical
  by_cases odd : HasOddRelation generators
  · have one_mem :
        (1 : PauliPhase) ∈
          scalarPhases
            (generatedPauliGroup generators) :=
      (one_mem_scalarPhases_iff_hasOddRelation
        generators).mpr odd
    simp [standardScalarPhaseRank,
      scalarPhaseRank, odd, one_mem]
  · have one_not_mem :
        (1 : PauliPhase) ∉
          scalarPhases
            (generatedPauliGroup generators) := by
      intro one_mem
      exact
        odd
          ((one_mem_scalarPhases_iff_hasOddRelation
            generators).mp one_mem)
    by_cases negative :
        HasNegativeStandardTrigger generators
    · have two_mem :
          (2 : PauliPhase) ∈
            scalarPhases
              (generatedPauliGroup generators) :=
        (two_mem_scalarPhases_iff_standard_classification
          generators).mpr (Or.inr negative)
      simp [standardScalarPhaseRank,
        scalarPhaseRank, odd, negative,
        one_not_mem, two_mem]
    · have two_not_mem :
          (2 : PauliPhase) ∉
            scalarPhases
              (generatedPauliGroup generators) := by
        intro two_mem
        rcases
            (two_mem_scalarPhases_iff_standard_classification
              generators).mp two_mem with
          odd_relation | negative_trigger
        · exact odd odd_relation
        · exact negative negative_trigger
      simp [standardScalarPhaseRank,
        scalarPhaseRank, odd, negative,
        one_not_mem, two_not_mem]

theorem AddSubgroup.phase_mem_of_one_mem
    (phases : AddSubgroup PauliPhase)
    (one_mem : (1 : PauliPhase) ∈ phases)
    (phase : PauliPhase) :
    phase ∈ phases := by
  rcases
      pauliPhase_eq_zero_or_one_or_two_or_three
        phase with
    rfl | rfl | rfl | rfl
  · exact phases.zero_mem
  · exact one_mem
  · have two_mem := phases.add_mem one_mem one_mem
    have one_add_one :
        (1 + 1 : PauliPhase) = 2 := by
      decide
    rw [one_add_one] at two_mem
    exact two_mem
  · have two_mem := phases.add_mem one_mem one_mem
    have one_add_one :
        (1 + 1 : PauliPhase) = 2 := by
      decide
    rw [one_add_one] at two_mem
    have three_mem := phases.add_mem two_mem one_mem
    have two_add_one :
        (2 + 1 : PauliPhase) = 3 := by
      decide
    rw [two_add_one] at three_mem
    exact three_mem

namespace Pauli

@[simp]
theorem phase_ofProjective
    (projective : ProjectivePauli m)
    (phase : PauliPhase) :
    (ofProjective projective phase).phase = phase := rfl

@[simp]
theorem scalar_mul
    (phase : PauliPhase)
    (pauli : Pauli m) :
    scalar (m := m) phase * pauli =
      ofProjective pauli.projective
        (phase + pauli.phase) := by
  apply Pauli.ext
  · change 0 + pauli.x = pauli.x
    exact zero_add _
  · change 0 + pauli.z = pauli.z
    exact zero_add _
  · change
      phase + pauli.phase +
          parityPhase
            (ProjectivePauli.xzCross 0
              pauli.projective) =
        phase + pauli.phase
    simp [ProjectivePauli.xzCross,
      dotProduct]

/-- Canonical representative of a phase modulo the sign phase `2`. -/
def parityNormalize (pauli : Pauli m) : Pauli m :=
  ofProjective pauli.projective
    (bitPhase (phaseParity pauli.phase))

@[simp]
theorem projective_parityNormalize
    (pauli : Pauli m) :
    pauli.parityNormalize.projective =
      pauli.projective := rfl

theorem parityNormalize_eq_self_or_neg
    (pauli : Pauli m) :
    pauli.parityNormalize = pauli ∨
      pauli.parityNormalize = -pauli := by
  rcases
      pauliPhase_eq_zero_or_one_or_two_or_three
        pauli.phase with
    phase_zero | phase_one | phase_two | phase_three
  · left
    apply Pauli.ext
    · rfl
    · rfl
    · simp [parityNormalize, phase_zero]
  · left
    apply Pauli.ext
    · rfl
    · rfl
    · simp [parityNormalize, phase_one]
  · right
    apply Pauli.ext
    · rfl
    · rfl
    · simp [parityNormalize, phase_two]
      decide
  · right
    apply Pauli.ext
    · rfl
    · rfl
    · simp [parityNormalize, phase_three]
      decide

@[simp]
theorem phase_parityNormalize_add_self
    (pauli : Pauli m) :
    pauli.parityNormalize.phase +
        pauli.parityNormalize.phase =
      pauli.phase + pauli.phase := by
  rcases
      pauliPhase_eq_zero_or_one_or_two_or_three
        pauli.phase with
    phase_zero | phase_one | phase_two | phase_three
  · simp [parityNormalize, phase_zero]
  · simp [parityNormalize, phase_one]
  · simp [parityNormalize, phase_two]
    decide
  · simp [parityNormalize, phase_three]
    decide

@[simp]
theorem isOrderTwo_parityNormalize_iff
    (pauli : Pauli m) :
    IsOrderTwo pauli.parityNormalize ↔
      IsOrderTwo pauli := by
  rw [isOrderTwo_iff_phase,
    isOrderTwo_iff_phase,
    projective_parityNormalize]
  rw [phase_parityNormalize_add_self]

@[simp]
theorem commute_parityNormalize_parityNormalize_iff
    (left right : Pauli m) :
    Commute left.parityNormalize right.parityNormalize ↔
      Commute left right := by
  rw [commute_iff_commutationPairing_eq_zero,
    commute_iff_commutationPairing_eq_zero,
    projective_parityNormalize,
    projective_parityNormalize]

end Pauli

/--
Final phase normalization used for pivot products: remove all phase when the
scalar kernel contains `i`, remove sign when it contains `-I`, and otherwise
leave the pivot unchanged.
-/
noncomputable def normalizedPivotPauliProduct
    (generators : List (DensePauli m))
    (pivot : EchelonPivotIndex generators) :
    Pauli m := by
  classical
  exact
    if HasOddRelation generators then
      Pauli.ofProjective
        (pivotPauliProduct generators pivot).projective 0
    else if HasNegativeStandardTrigger generators then
      (pivotPauliProduct generators pivot).parityNormalize
    else
      pivotPauliProduct generators pivot

@[simp]
theorem normalizedPivotPauliProduct_projective
    (generators : List (DensePauli m))
    (pivot : EchelonPivotIndex generators) :
    (normalizedPivotPauliProduct
      generators pivot).projective =
        (pivotPauliProduct
          generators pivot).projective := by
  classical
  by_cases odd : HasOddRelation generators
  · simp [normalizedPivotPauliProduct, odd]
  · by_cases negative :
        HasNegativeStandardTrigger generators
    · simp [normalizedPivotPauliProduct,
        odd, negative]
    · simp [normalizedPivotPauliProduct,
        odd, negative]

theorem normalizedPivotPauliProduct_mem_generatedPauliGroup
    (generators : List (DensePauli m))
    (pivot : EchelonPivotIndex generators) :
    normalizedPivotPauliProduct generators pivot ∈
      generatedPauliGroup generators := by
  classical
  have pivot_mem :
      pivotPauliProduct generators pivot ∈
        generatedPauliGroup generators :=
    echelonPauliProduct_mem_generatedPauliGroup
      generators
      ⟨pivot.val,
        pivot.isLt.trans_le
          (EchelonForm.new_pivots_length_le
            (bitMatrixFromPaulis generators))⟩
  by_cases odd : HasOddRelation generators
  · simp only [normalizedPivotPauliProduct,
      odd, ↓reduceIte]
    have one_mem :
        (1 : PauliPhase) ∈
          scalarPhases
            (generatedPauliGroup generators) :=
      (one_mem_scalarPhases_iff_hasOddRelation
        generators).mpr odd
    have correction_mem :
        (-(pivotPauliProduct
            generators pivot).phase) ∈
          scalarPhases
            (generatedPauliGroup generators) :=
      AddSubgroup.phase_mem_of_one_mem
        (scalarPhases
          (generatedPauliGroup generators))
        one_mem _
    change
      Pauli.scalar (m := m)
          (-(pivotPauliProduct
            generators pivot).phase) ∈
        generatedPauliGroup generators at correction_mem
    have product_mem :=
      (generatedPauliGroup generators).mul_mem
        correction_mem pivot_mem
    rw [Pauli.scalar_mul] at product_mem
    simpa using product_mem
  · by_cases negative :
        HasNegativeStandardTrigger generators
    · simp only [normalizedPivotPauliProduct,
        odd, negative, ↓reduceIte]
      have two_mem :
          (2 : PauliPhase) ∈
            scalarPhases
              (generatedPauliGroup generators) :=
        (two_mem_scalarPhases_iff_standard_classification
          generators).mpr (Or.inr negative)
      change
        Pauli.scalar (m := m) 2 ∈
          generatedPauliGroup generators at two_mem
      rcases
          Pauli.parityNormalize_eq_self_or_neg
            (pivotPauliProduct generators pivot) with
        equal_self | equal_neg
      · rw [equal_self]
        exact pivot_mem
      · rw [equal_neg, ← Pauli.scalar_two_mul]
        exact
          (generatedPauliGroup generators).mul_mem
            two_mem pivot_mem
    · simp only [normalizedPivotPauliProduct,
        odd, negative, ↓reduceIte]
      exact pivot_mem

/-- Subgroup generated by the phase-normalized pivot products. -/
noncomputable def normalizedPivotPauliGroup
    (generators : List (DensePauli m)) :
    Subgroup (Pauli m) :=
  Subgroup.closure
    (Set.range
      (normalizedPivotPauliProduct generators))

/--
Scalar relation generator retained by Rust standardization. The implementation
omits a redundant `-I` relation when a normalized pivot square or commutator
already generates it. Rust also inserts identity sentinels when its output
would otherwise be empty; those do not change the subgroup and are omitted.
-/
noncomputable def standardRelationPhaseGroup
    (generators : List (DensePauli m)) :
    Subgroup (Pauli m) := by
  classical
  exact
    if HasOddRelation generators then
      Subgroup.closure
        ({Pauli.scalar (m := m) 1} : Set (Pauli m))
    else if
        HasPhaseTwoRelation generators ∧
          ¬HasPivotNegativeTrigger generators then
      Subgroup.closure
        ({Pauli.scalar (m := m) 2} : Set (Pauli m))
    else
      ⊥

/-- Semantic group generated by Rust's phase-normalized standard generators. -/
noncomputable def standardPauliGroup
    (generators : List (DensePauli m)) :
    Subgroup (Pauli m) :=
  normalizedPivotPauliGroup generators ⊔
    standardRelationPhaseGroup generators

theorem normalizedPivotPauliProduct_mem_standardPauliGroup
    (generators : List (DensePauli m))
    (pivot : EchelonPivotIndex generators) :
    normalizedPivotPauliProduct generators pivot ∈
      standardPauliGroup generators := by
  apply
    (show
      normalizedPivotPauliGroup generators ≤
        standardPauliGroup generators from
      le_sup_left)
  exact
    Subgroup.subset_closure
      (Set.mem_range_self pivot)

theorem scalar_one_mem_standardPauliGroup_of_odd_relation
    (generators : List (DensePauli m))
    (odd : HasOddRelation generators) :
    Pauli.scalar (m := m) 1 ∈
      standardPauliGroup generators := by
  apply
    (show
      standardRelationPhaseGroup generators ≤
        standardPauliGroup generators from
      le_sup_right)
  simp only [standardRelationPhaseGroup,
    odd, ↓reduceIte]
  exact
    Subgroup.subset_closure
      (Set.mem_singleton _)

theorem scalar_two_mem_standardPauliGroup_of_phase_two_relation
    (generators : List (DensePauli m))
    (odd : ¬HasOddRelation generators)
    (phase_two : HasPhaseTwoRelation generators)
    (no_pivot_negative :
      ¬HasPivotNegativeTrigger generators) :
    Pauli.scalar (m := m) 2 ∈
      standardPauliGroup generators := by
  apply
    (show
      standardRelationPhaseGroup generators ≤
        standardPauliGroup generators from
      le_sup_right)
  simp only [standardRelationPhaseGroup,
    odd, phase_two, no_pivot_negative,
    not_false_eq_true, and_self, ↓reduceIte]
  exact
    Subgroup.subset_closure
      (Set.mem_singleton _)

theorem normalizedPivotPauliGroup_le_generatedPauliGroup
    (generators : List (DensePauli m)) :
    normalizedPivotPauliGroup generators ≤
      generatedPauliGroup generators := by
  rw [normalizedPivotPauliGroup,
    Subgroup.closure_le]
  rintro _ ⟨pivot, rfl⟩
  exact
    normalizedPivotPauliProduct_mem_generatedPauliGroup
      generators pivot

theorem standardRelationPhaseGroup_le_generatedPauliGroup
    (generators : List (DensePauli m)) :
    standardRelationPhaseGroup generators ≤
      generatedPauliGroup generators := by
  classical
  by_cases odd : HasOddRelation generators
  · simp only [standardRelationPhaseGroup,
      odd, ↓reduceIte, Subgroup.closure_le]
    intro scalar scalar_mem
    rw [Set.mem_singleton_iff] at scalar_mem
    subst scalar
    exact
      (one_mem_scalarPhases_iff_hasOddRelation
        generators).mpr odd
  · by_cases phase_two :
        HasPhaseTwoRelation generators
    · by_cases pivot_negative :
          HasPivotNegativeTrigger generators
      · simp [standardRelationPhaseGroup,
          odd, phase_two, pivot_negative]
      · simp only [standardRelationPhaseGroup,
          odd, phase_two, pivot_negative,
          not_false_eq_true, and_self,
          ↓reduceIte, Subgroup.closure_le]
        intro scalar scalar_mem
        rw [Set.mem_singleton_iff] at scalar_mem
        subst scalar
        exact
          (two_mem_scalarPhases_iff_standard_classification
            generators).mpr
              (Or.inr (Or.inl phase_two))
    · simp [standardRelationPhaseGroup,
        odd, phase_two]

theorem standardPauliGroup_le_generatedPauliGroup
    (generators : List (DensePauli m)) :
    standardPauliGroup generators ≤
      generatedPauliGroup generators := by
  exact
    sup_le
      (normalizedPivotPauliGroup_le_generatedPauliGroup
        generators)
      (standardRelationPhaseGroup_le_generatedPauliGroup
        generators)

theorem scalar_two_mem_standardPauliGroup_of_pivot_trigger
    (generators : List (DensePauli m))
    (odd : ¬HasOddRelation generators)
    (pivot_negative :
      HasPivotNegativeTrigger generators) :
    Pauli.scalar (m := m) 2 ∈
      standardPauliGroup generators := by
  have negative_trigger :
      HasNegativeStandardTrigger generators :=
    Or.inr pivot_negative
  rcases pivot_negative with
    pivot_not_order_two | pivots_not_commute
  · rcases pivot_not_order_two with
      ⟨pivot, not_order_two⟩
    have normalized_mem :=
      normalizedPivotPauliProduct_mem_standardPauliGroup
        generators pivot
    have normalized_not_order_two :
        ¬Pauli.IsOrderTwo
          (normalizedPivotPauliProduct
            generators pivot) := by
      intro normalized_order_two
      apply not_order_two
      have normalized_eq :
          normalizedPivotPauliProduct
              generators pivot =
            (pivotPauliProduct
              generators pivot).parityNormalize := by
        simp [normalizedPivotPauliProduct,
          odd, negative_trigger]
      apply
        (Pauli.isOrderTwo_parityNormalize_iff
          (pivotPauliProduct
            generators pivot)).mp
      rw [← normalized_eq]
      exact normalized_order_two
    exact
      scalar_two_mem_of_not_isOrderTwo
        (standardPauliGroup generators)
        normalized_mem normalized_not_order_two
  · rcases pivots_not_commute with
      ⟨left, right, not_commute⟩
    have left_mem :=
      normalizedPivotPauliProduct_mem_standardPauliGroup
        generators left
    have right_mem :=
      normalizedPivotPauliProduct_mem_standardPauliGroup
        generators right
    have pairing_nonzero :
        ProjectivePauli.commutationPairing
            (pivotPauliProduct
              generators left).projective
            (pivotPauliProduct
              generators right).projective ≠
          0 := by
      intro pairing_zero
      apply not_commute
      exact
        (Pauli.commute_iff_commutationPairing_eq_zero
          (pivotPauliProduct generators left)
          (pivotPauliProduct generators right)).mpr
            pairing_zero
    have pairing_one :
        ProjectivePauli.commutationPairing
            (pivotPauliProduct
              generators left).projective
            (pivotPauliProduct
              generators right).projective =
          1 :=
      (Pauli.f2_eq_zero_or_one _).resolve_left
        pairing_nonzero
    have normalized_pairing_one :
        ProjectivePauli.commutationPairing
            (normalizedPivotPauliProduct
              generators left).projective
            (normalizedPivotPauliProduct
              generators right).projective =
          1 := by
      rw [normalizedPivotPauliProduct_projective,
        normalizedPivotPauliProduct_projective]
      exact pairing_one
    exact
      scalar_two_mem_of_anticommutes
        (standardPauliGroup generators)
        left_mem right_mem normalized_pairing_one

theorem scalarPauliSubgroup_le_standardPauliGroup
    (generators : List (DensePauli m)) :
    scalarPauliSubgroup
        (scalarPhases
          (generatedPauliGroup generators)) ≤
      standardPauliGroup generators := by
  classical
  intro pauli member
  rw [Pauli.eq_scalar_phase_of_projective_eq_zero
    pauli member.1]
  change
    pauli.phase ∈
      scalarPhases
        (standardPauliGroup generators)
  by_cases odd : HasOddRelation generators
  · have one_mem :
        (1 : PauliPhase) ∈
          scalarPhases
            (standardPauliGroup generators) :=
      scalar_one_mem_standardPauliGroup_of_odd_relation
        generators odd
    exact
      AddSubgroup.phase_mem_of_one_mem
        (scalarPhases
          (standardPauliGroup generators))
        one_mem pauli.phase
  · rcases
        pauliPhase_eq_zero_or_one_or_two_or_three
          pauli.phase with
      phase_zero | phase_one | phase_two | phase_three
    · rw [phase_zero]
      exact
        (scalarPhases
          (standardPauliGroup generators)).zero_mem
    · have one_mem :
          (1 : PauliPhase) ∈
            scalarPhases
              (generatedPauliGroup generators) := by
        simpa [phase_one] using member.2
      exact
        (odd
          ((one_mem_scalarPhases_iff_hasOddRelation
            generators).mp one_mem)).elim
    · rw [phase_two]
      by_cases relation_two :
          HasPhaseTwoRelation generators
      · by_cases pivot_negative :
            HasPivotNegativeTrigger generators
        · exact
            scalar_two_mem_standardPauliGroup_of_pivot_trigger
              generators odd pivot_negative
        · exact
            scalar_two_mem_standardPauliGroup_of_phase_two_relation
              generators odd relation_two pivot_negative
      · have two_mem :
          (2 : PauliPhase) ∈
            scalarPhases
              (generatedPauliGroup generators) := by
          simpa [phase_two] using member.2
        rcases
            (two_mem_scalarPhases_iff_standard_classification
              generators).mp two_mem with
          odd_relation | negative
        · exact (odd odd_relation).elim
        · rcases negative with
            relation_two' | pivot_negative
          · exact (relation_two relation_two').elim
          · exact
              scalar_two_mem_standardPauliGroup_of_pivot_trigger
                generators odd pivot_negative
    · have three_mem :
          (3 : PauliPhase) ∈
            scalarPhases
              (generatedPauliGroup generators) := by
        simpa [phase_three] using member.2
      have one_mem :=
        (scalarPhases
          (generatedPauliGroup generators)).neg_mem
            three_mem
      have neg_three :
          (-(3 : PauliPhase)) = 1 := by
        decide
      rw [neg_three] at one_mem
      exact
        (odd
          ((one_mem_scalarPhases_iff_hasOddRelation
            generators).mp one_mem)).elim

/-- Echelon products completed by the semantic scalar phase kernel. -/
def rawStandardPauliGroup
    (generators : List (DensePauli m)) :
    Subgroup (Pauli m) :=
  echelonPauliGroup generators ⊔
    scalarPauliSubgroup
      (scalarPhases
        (generatedPauliGroup generators))

theorem rawStandardPauliGroup_eq_generatedPauliGroup
    (generators : List (DensePauli m)) :
    rawStandardPauliGroup generators =
      generatedPauliGroup generators := by
  apply le_antisymm
  · rw [rawStandardPauliGroup]
    exact sup_le
      (echelonPauliGroup_le_generatedPauliGroup
        generators)
      (scalarPauliSubgroup_le_group _)
  · intro pauli member
    rcases
        exists_mem_echelonPauliGroup_same_projectiveRow
          generators member with
      ⟨transformed, transformed_mem, rows_equal⟩
    have projective_equal :
        transformed.projective = pauli.projective :=
      Pauli.projective_eq_of_projectiveRow_eq rows_equal
    let correction := pauli * transformed⁻¹
    have transformed_generated :
        transformed ∈ generatedPauliGroup generators :=
      echelonPauliGroup_le_generatedPauliGroup
        generators transformed_mem
    have correction_mem :
        correction ∈ generatedPauliGroup generators :=
      Subgroup.mul_mem _
        member
        (Subgroup.inv_mem _ transformed_generated)
    have correction_projective :
        correction.projective = 0 := by
      change
        (pauli * transformed⁻¹).projective = 0
      rw [Pauli.projective_mul,
        Pauli.projective_inv, projective_equal,
        ProjectivePauli.add_self_eq_zero]
    have correction_phase_mem :
        correction.phase ∈
          scalarPhases
            (generatedPauliGroup generators) := by
      change
        Pauli.scalar (m := m) correction.phase ∈
          generatedPauliGroup generators
      rw [← Pauli.eq_scalar_phase_of_projective_eq_zero
        correction correction_projective]
      exact correction_mem
    have correction_standard :
        correction ∈ rawStandardPauliGroup generators := by
      apply
        (show
          scalarPauliSubgroup
              (scalarPhases
                (generatedPauliGroup generators)) ≤
            rawStandardPauliGroup generators from
          le_sup_right)
      exact
        ⟨correction_projective,
          correction_phase_mem⟩
    have transformed_standard :
        transformed ∈ rawStandardPauliGroup generators :=
      (show
        echelonPauliGroup generators ≤
          rawStandardPauliGroup generators from
        le_sup_left) transformed_mem
    have recombine :
        correction * transformed = pauli := by
      simp [correction, mul_assoc]
    rw [← recombine]
    exact
      Subgroup.mul_mem _
        correction_standard transformed_standard

theorem mem_standardPauliGroup_of_mem_generated_projective_zero
    (generators : List (DensePauli m))
    {pauli : Pauli m}
    (member :
      pauli ∈ generatedPauliGroup generators)
    (projective_zero : pauli.projective = 0) :
    pauli ∈ standardPauliGroup generators := by
  apply
    scalarPauliSubgroup_le_standardPauliGroup
      generators
  constructor
  · exact projective_zero
  · change
      Pauli.scalar (m := m) pauli.phase ∈
        generatedPauliGroup generators
    rw [←
      Pauli.eq_scalar_phase_of_projective_eq_zero
        pauli projective_zero]
    exact member

theorem pivotPauliProduct_mem_standardPauliGroup
    (generators : List (DensePauli m))
    (pivot : EchelonPivotIndex generators) :
    pivotPauliProduct generators pivot ∈
      standardPauliGroup generators := by
  let normalized :=
    normalizedPivotPauliProduct generators pivot
  let correction :=
    pivotPauliProduct generators pivot * normalized⁻¹
  have pivot_generated :
      pivotPauliProduct generators pivot ∈
        generatedPauliGroup generators :=
    echelonPauliProduct_mem_generatedPauliGroup
      generators
      ⟨pivot.val,
        pivot.isLt.trans_le
          (EchelonForm.new_pivots_length_le
            (bitMatrixFromPaulis generators))⟩
  have normalized_generated :
      normalized ∈ generatedPauliGroup generators :=
    normalizedPivotPauliProduct_mem_generatedPauliGroup
      generators pivot
  have correction_generated :
      correction ∈ generatedPauliGroup generators :=
    (generatedPauliGroup generators).mul_mem
      pivot_generated
      ((generatedPauliGroup generators).inv_mem
        normalized_generated)
  have correction_projective :
      correction.projective = 0 := by
    change
      (pivotPauliProduct generators pivot *
          (normalizedPivotPauliProduct
            generators pivot)⁻¹).projective =
        0
    rw [Pauli.projective_mul,
      Pauli.projective_inv,
      normalizedPivotPauliProduct_projective,
      ProjectivePauli.add_self_eq_zero]
  have correction_standard :
      correction ∈ standardPauliGroup generators :=
    mem_standardPauliGroup_of_mem_generated_projective_zero
      generators correction_generated correction_projective
  have normalized_standard :
      normalized ∈ standardPauliGroup generators :=
    normalizedPivotPauliProduct_mem_standardPauliGroup
      generators pivot
  have recombine :
      correction * normalized =
        pivotPauliProduct generators pivot := by
    simp [correction, normalized, mul_assoc]
  rw [← recombine]
  exact
    (standardPauliGroup generators).mul_mem
      correction_standard normalized_standard

theorem relationPauliProduct_mem_standardPauliGroup
    (generators : List (DensePauli m))
    (row : EchelonRelationIndex generators) :
    relationPauliProduct generators row ∈
      standardPauliGroup generators := by
  exact
    mem_standardPauliGroup_of_mem_generated_projective_zero
      generators
      (echelonPauliProduct_mem_generatedPauliGroup
        generators row.1)
      (relationPauliProduct_projective generators row)

theorem echelonPauliGroup_le_standardPauliGroup
    (generators : List (DensePauli m)) :
    echelonPauliGroup generators ≤
      standardPauliGroup generators := by
  rw [echelonPauliGroup,
    Subgroup.closure_le]
  rintro _ ⟨row, rfl⟩
  by_cases is_pivot :
      row.val <
        (EchelonForm.new
          (bitMatrixFromPaulis generators)).pivots.length
  · rw [echelonPauliProduct_eq_pivotPauliProduct
      generators row is_pivot]
    exact
      pivotPauliProduct_mem_standardPauliGroup
        generators ⟨row.val, is_pivot⟩
  · have is_relation :
        (EchelonForm.new
          (bitMatrixFromPaulis generators)).pivots.length ≤
            row.val :=
      Nat.le_of_not_gt is_pivot
    rw [echelonPauliProduct_eq_relationPauliProduct
      generators row is_relation]
    exact
      relationPauliProduct_mem_standardPauliGroup
        generators ⟨row, is_relation⟩

theorem generatedPauliGroup_le_standardPauliGroup
    (generators : List (DensePauli m)) :
    generatedPauliGroup generators ≤
      standardPauliGroup generators := by
  rw [← rawStandardPauliGroup_eq_generatedPauliGroup,
    rawStandardPauliGroup]
  exact
    sup_le
      (echelonPauliGroup_le_standardPauliGroup
        generators)
      (scalarPauliSubgroup_le_standardPauliGroup
        generators)

theorem standardPauliGroup_eq_generatedPauliGroup
    (generators : List (DensePauli m)) :
    standardPauliGroup generators =
      generatedPauliGroup generators :=
  le_antisymm
    (standardPauliGroup_le_generatedPauliGroup
      generators)
    (generatedPauliGroup_le_standardPauliGroup
      generators)

/-- Rust's `binary_rank`: the number of pivots in the verified RREF. -/
def standardBinaryRank
    (generators : List (DensePauli m)) : ℕ :=
  (EchelonForm.new
    (bitMatrixFromPaulis generators)).pivots.length

theorem standardBinaryRank_eq_finrank_projectiveSpan
    (generators : List (DensePauli m)) :
    standardBinaryRank generators =
      Module.finrank F2 (projectiveSpan generators) := by
  rw [standardBinaryRank,
    EchelonForm.new_pivots_length_eq_rank,
    Matrix.rank_eq_finrank_span_row]
  exact
    congrArg
      (fun submodule :
          Submodule F2 (Fin (m + m) → F2) =>
        Module.finrank F2 submodule)
      (bitMatrixFromPaulis_rowSpace generators)

/-- Structural logarithm used by Rust's `log2_size`. -/
noncomputable def standardLog2Size
    (generators : List (DensePauli m)) : ℕ :=
  standardBinaryRank generators +
    standardScalarPhaseRank generators

theorem standardLog2Size_eq_semantic_ranks
    (generators : List (DensePauli m)) :
    standardLog2Size generators =
      Module.finrank F2 (projectiveSpan generators) +
        scalarPhaseRank
          (scalarPhases
            (generatedPauliGroup generators)) := by
  rw [standardLog2Size,
    standardBinaryRank_eq_finrank_projectiveSpan,
    standardScalarPhaseRank_eq_scalarPhaseRank]

end PaulimerFormal
